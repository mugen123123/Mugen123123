text({
	Position = UDim2.new(0, 0, 0, 56), Size = UDim2.new(1, 0, 1, -56), Font = FONT_LIGHT, TextSize = 18,
	TextColor3 = Color3.fromRGB(220, 222, 235), LineHeight = 1.25,
	Text = "WASD  move          C  crouch          E  takedown / use          Q, R  tools\n\n"
