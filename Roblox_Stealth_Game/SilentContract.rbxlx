<Item class="ServerScriptService" referent="RBX6"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX4"><Properties><string name="Name">StealthServer</string><ProtectedString name="Source"><![CDATA[-- StealthServer (Script, goes in ServerScriptService)
-- Builds a private copy of the building for every player and runs their mission:
-- guard patrols, what guards can see and hear, takedowns, tools, and the final grade.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local PathfindingService = game:GetService("PathfindingService")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage:WaitForChild("StealthConfig"))
local LevelDef = Config.Level
local Props = require(script.Parent:WaitForChild("StealthProps"))

local VIEW_COS = math.cos(math.rad(Config.VIEW_HALF_ANGLE))
local CHASE_COS = math.cos(math.rad(80)) -- a guard who is chasing you sees much wider
local GUARD_Y = 3 -- height of a guard's middle above the floor

---------------------------------------------------------------------------
-- Remotes
---------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "StealthRemotes"
local function makeRemote(name)
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
	return r
end
local StartRemote = makeRemote("Start")       -- client -> server: (list of tool names)
local ActionRemote = makeRemote("Action")     -- client -> server: E key (takedown / fuse box)
local ToolRemote = makeRemote("UseTool")      -- client -> server: (toolName, aimPosition)
local CrouchRemote = makeRemote("Crouch")     -- client -> server: (isCrouching)
local RetryRemote = makeRemote("Retry")       -- client -> server
local ResultRemote = makeRemote("Result")     -- server -> client: (results table)
local FxRemote = makeRemote("Fx")             -- server -> client: (effectName, ...)
remotes.Parent = ReplicatedStorage

---------------------------------------------------------------------------
-- Guard character models
---------------------------------------------------------------------------
-- Real Roblox character rigs for the guards and the target. Each player's client copies
-- these, dresses them and animates them. The server only tracks where guards are.
local rigs = Instance.new("Folder")
rigs.Name = "StealthRigs"
rigs.Parent = ReplicatedStorage

local function makeRigTemplate(name, skin, suit, trousers)
	task.spawn(function()
		local desc = Instance.new("HumanoidDescription")
		desc.HeadColor = skin
		desc.TorsoColor = suit
		desc.LeftArmColor = suit
		desc.RightArmColor = suit
		desc.LeftLegColor = trousers
		desc.RightLegColor = trousers
		local ok, rig = pcall(function()
			return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
		end)
		if ok and rig then
			rig.Name = name
			for _, d in ipairs(rig:GetDescendants()) do
				if d:IsA("LuaSourceContainer") then
					d:Destroy()
				end
			end
			rig.Parent = rigs
		else
			warn("Could not make " .. name .. ": " .. tostring(rig))
		end
	end)
end
makeRigTemplate("GuardRig", Color3.fromRGB(222, 184, 156), Color3.fromRGB(30, 36, 56), Color3.fromRGB(18, 19, 24))
makeRigTemplate("TargetRig", Color3.fromRGB(232, 196, 170), Color3.fromRGB(128, 22, 32), Color3.fromRGB(24, 20, 22))

-- Guard characters are only for looks, so they must never bump into players.
pcall(function()
	local PhysicsService = game:GetService("PhysicsService")
	PhysicsService:RegisterCollisionGroup("StealthGhost")
	PhysicsService:CollisionGroupSetCollidable("StealthGhost", "Default", false)
end)

---------------------------------------------------------------------------
-- Night-time look
---------------------------------------------------------------------------
Lighting.ClockTime = 0
Lighting.Brightness = 0.4
Lighting.Ambient = Color3.fromRGB(42, 46, 64)
Lighting.OutdoorAmbient = Color3.fromRGB(30, 34, 50)
Lighting.FogColor = Color3.fromRGB(8, 10, 18)
Lighting.FogEnd = 400
Lighting.GlobalShadows = true
if not Lighting:FindFirstChild("StealthBloom") then
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "StealthBloom"
	bloom.Intensity = 0.6
	bloom.Size = 28
	bloom.Threshold = 1.2
	bloom.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "StealthColor"
	cc.Contrast = 0.15
	cc.Saturation = -0.15
	cc.TintColor = Color3.fromRGB(225, 232, 255)
	cc.Parent = Lighting
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "StealthAtmosphere"
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.1
	atmosphere.Color = Color3.fromRGB(70, 80, 110)
	atmosphere.Decay = Color3.fromRGB(20, 24, 40)
	atmosphere.Glare = 0
	atmosphere.Haze = 1.6
	atmosphere.Parent = Lighting
end

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
-- A hidden spot to stand on for the split second between spawning and being moved into the building.
local spawnPad = Instance.new("SpawnLocation")
spawnPad.Name = "StealthSpawn"
spawnPad.Anchored = true
spawnPad.Size = Vector3.new(30, 1, 30)
spawnPad.Position = Vector3.new(0, Config.BASE_HEIGHT, 0)
spawnPad.Transparency = 1
spawnPad.Parent = workspace

local missions = {} -- [player] = mission table
local slots = {}    -- which building spots are taken

local function makePart(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = parent
	return p
end

-- Turns level coordinates (x, z, height above the floor) into a world position.
local function P(m, x, z, y)
	return m.origin + Vector3.new(x, y or 0, z)
end

local function lerp(a, b, t)
	return a + (b - a) * t
end

local function setAttr(instance, name, value)
	if instance:GetAttribute(name) ~= value then
		instance:SetAttribute(name, value)
	end
end

-- Shortest distance from point p to the line segment a-b (ignoring height).
local function distToSegment(p, a, b)
	local ab = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local ap = Vector3.new(p.X - a.X, 0, p.Z - a.Z)
	local len2 = ab:Dot(ab)
	local t = 0
	if len2 > 0.001 then
		t = math.clamp(ap:Dot(ab) / len2, 0, 1)
	end
	return (ap - ab * t).Magnitude
end

local function getCharacterParts(player)
	local char = player.Character
	if not char then
		return nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if hum and root and hum.Health > 0 then
		return hum, root, char
	end
	return nil
end

---------------------------------------------------------------------------
-- Building the level
---------------------------------------------------------------------------
local function addWall(m, spec, decor)
	local cuts = { spec.from }
	for _, gap in ipairs(spec.gaps or {}) do
		table.insert(cuts, gap[1])
		table.insert(cuts, gap[2])
	end
	table.insert(cuts, spec.to)
	local h = Config.WALL_HEIGHT
	for i = 1, #cuts, 2 do
		local a, b = cuts[i], cuts[i + 1]
		if b - a > 0.1 then
			local mid, len = (a + b) / 2, b - a
			local size, pos, grow
			if spec.axis == "x" then
				size = Vector3.new(len + 1, h, 1)
				pos = P(m, mid, spec.fixed, h / 2)
				grow = Vector3.new(0, 0, 0.3)
			else
				size = Vector3.new(1, h, len + 1)
				pos = P(m, spec.fixed, mid, h / 2)
				grow = Vector3.new(0.3, 0, 0)
			end
			makePart(m.solid, {
				Name = "Wall", Size = size, Position = pos,
				Color = Color3.fromRGB(64, 66, 80), Material = Enum.Material.Concrete,
			})
			local function trim(name, height, y, color, material)
				makePart(decor, {
					Name = name, Size = Vector3.new(size.X, height, size.Z) + grow,
					Position = Vector3.new(pos.X, m.origin.Y + y, pos.Z), Color = color, Material = material,
					CanCollide = false, CanQuery = false, CastShadow = false,
				})
			end
			trim("Baseboard", 0.7, 0.35, Color3.fromRGB(34, 26, 22), Enum.Material.Wood)
			trim("WallCap", 0.25, h + 0.12, Color3.fromRGB(30, 31, 38), Enum.Material.SmoothPlastic)
			makePart(decor, {
				Name = "WallCapLine", Size = Vector3.new(size.X, 0.06, size.Z) - grow * 2,
				Position = Vector3.new(pos.X, m.origin.Y + h + 0.27, pos.Z),
				Color = Color3.fromRGB(190, 150, 80), Material = Enum.Material.Metal,
				CanCollide = false, CanQuery = false, CastShadow = false,
			})
		end
	end
end

local function buildLevel(m)
	local level = Instance.new("Model")
	level.Name = "Level_" .. m.player.UserId
	level:SetAttribute("Origin", m.origin)
	m.level = level

	local function folder(name)
		local f = Instance.new("Folder")
		f.Name = name
		f.Parent = level
		return f
	end
	m.solid = folder("Solid")      -- walls and tall cover: block movement and sight
	m.lowFolder = folder("Low")    -- low furniture: blocks movement only
	m.guardsFolder = folder("Guards")
	local decor = folder("Decor")  -- everything that is only for looks
	local ctx = {
		decor = decor,
		at = function(x, z, y)
			return P(m, x, z, y)
		end,
	}

	-- Floors, one per room so each room has its own material
	local w, d = LevelDef.halfWidth * 2, LevelDef.halfDepth * 2
	makePart(level, {
		Name = "Base", Size = Vector3.new(w + 6, 2, d + 6), Position = P(m, 0, 0, -2),
		Color = Color3.fromRGB(24, 25, 30), Material = Enum.Material.Concrete,
	})
	for _, r in ipairs(LevelDef.rooms) do
		makePart(level, {
			Name = "Floor", Size = Vector3.new(r[3] - r[1], 1, r[4] - r[2]),
			Position = P(m, (r[1] + r[3]) / 2, (r[2] + r[4]) / 2, -0.5),
			Color = Color3.fromRGB(r[6][1], r[6][2], r[6][3]), Material = Enum.Material[r[5]],
		})
	end
	for _, r in ipairs(LevelDef.rugs) do
		makePart(decor, {
			Name = "Rug", Size = Vector3.new(r[3], 0.06, r[4]), Position = P(m, r[1], r[2], 0.03),
			Color = Color3.fromRGB(r[5][1], r[5][2], r[5][3]), Material = Enum.Material.Fabric,
			CanCollide = false, CanQuery = false, CastShadow = false,
		})
		makePart(decor, {
			Name = "RugBorder", Size = Vector3.new(r[3] + 0.6, 0.04, r[4] + 0.6), Position = P(m, r[1], r[2], 0.02),
			Color = Color3.fromRGB(190, 150, 80), Material = Enum.Material.Fabric,
			CanCollide = false, CanQuery = false, CastShadow = false,
		})
	end

	for _, spec in ipairs(LevelDef.walls) do
		addWall(m, spec, decor)
	end

	for _, c in ipairs(LevelDef.cover) do
		makePart(m.solid, {
			Name = "Cover", Size = Vector3.new(c[4], Config.COVER_HEIGHT, c[5]),
			Position = P(m, c[2], c[3], Config.COVER_HEIGHT / 2), Transparency = 1,
		})
		Props.buildTall(ctx, c[1], c[2], c[3], c[4], c[5], c[6])
	end
	for _, c in ipairs(LevelDef.low) do
		makePart(m.lowFolder, {
			Name = "LowCover", Size = Vector3.new(c[4], 3, c[5]),
			Position = P(m, c[2], c[3], 1.5), Transparency = 1, CanQuery = false,
		})
		Props.buildLow(ctx, c[1], c[2], c[3], c[4], c[5], c[6])
	end

	m.lamps = {}
	for _, l in ipairs(LevelDef.lamps) do
		local shade, light = Props.lamp(ctx, l[1], l[2], Config.LAMP_RADIUS)
		table.insert(m.lamps, { bulb = shade, light = light, pos = P(m, l[1], l[2], GUARD_Y) })
	end

	m.fuseBox = makePart(level, {
		Name = "FuseBox", Size = Vector3.new(1, 4, 3),
		Position = P(m, LevelDef.fuseBox[1], LevelDef.fuseBox[2], 3), Transparency = 1,
	})
	Props.fuseBox(ctx, LevelDef.fuseBox[1], LevelDef.fuseBox[2])

	m.exitPad = makePart(level, {
		Name = "ExitPad", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 9, 9),
		CFrame = CFrame.new(P(m, LevelDef.exit[1], LevelDef.exit[2], 0.15)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(80, 255, 140), Material = Enum.Material.Neon,
		Transparency = 1, CanCollide = false, CanQuery = false, CastShadow = false,
	})
	m.exitBeam = makePart(level, {
		Name = "ExitBeam", Shape = Enum.PartType.Cylinder, Size = Vector3.new(40, 1.2, 1.2),
		CFrame = CFrame.new(P(m, LevelDef.exit[1], LevelDef.exit[2], 20)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(80, 255, 140), Material = Enum.Material.Neon,
		Transparency = 1, CanCollide = false, CanQuery = false, CastShadow = false,
	})

	Props.skyline(ctx, LevelDef.halfWidth, LevelDef.halfDepth)

	m.rayParams = RaycastParams.new()
	m.rayParams.FilterType = Enum.RaycastFilterType.Include
	m.rayParams.FilterDescendantsInstances = { m.solid }

	level.Parent = workspace
end

local function buildGuard(m, spec, index)
	local model = Instance.new("Model")
	model.Name = "Guard" .. index
	local first = spec.points[1]
	local pos = P(m, first[1], first[2], GUARD_Y)

	-- The server only moves this invisible Root. Each player's client attaches an
	-- animated character to it (see StealthClient).
	local root = makePart(model, {
		Name = "Root", Size = Vector3.new(2, 5, 1), CFrame = CFrame.new(pos),
		Transparency = 1, CanCollide = false, CanQuery = false,
	})
	root:SetAttribute("State", "patrol")
	root:SetAttribute("Meter", 0)
	root:SetAttribute("Down", false)
	root:SetAttribute("IsTarget", spec.target == true)
	root:SetAttribute("GuardName", spec.name)
	model.Parent = m.guardsFolder

	return {
		spec = spec, root = root, pos = pos, look = Vector3.new(0, 0, -1),
		state = "patrol", meter = 0, wp = 1, wpDir = 1, waitUntil = 0,
		path = nil, pathIndex = 1, token = 0, arrivedAt = nil,
		lastSeen = pos, lostAt = nil, noiseReadyAt = 0, down = false, found = false,
	}
end

local function spawnGuards(m)
	m.guardsFolder:ClearAllChildren()
	m.guards = {}
	for i, spec in ipairs(LevelDef.guards) do
		table.insert(m.guards, buildGuard(m, spec, i))
	end
end

---------------------------------------------------------------------------
-- Lights
---------------------------------------------------------------------------
local function setLights(m, on)
	m.lightsOff = not on
	for _, lamp in ipairs(m.lamps) do
		lamp.light.Enabled = on
		lamp.bulb.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
		lamp.bulb.Color = on and Color3.fromRGB(255, 214, 150) or Color3.fromRGB(50, 50, 55)
	end
	setAttr(m.level, "LightsOff", not on)
end

local function cutPower(m)
	m.lightsOffUntil = os.clock() + Config.POWER_CUT_TIME
	setLights(m, false)
	FxRemote:FireClient(m.player, "PowerCut", Config.POWER_CUT_TIME)
end

local function isLit(m, point)
	if m.lightsOff then
		return false
	end
	for _, lamp in ipairs(m.lamps) do
		local dx, dz = lamp.pos.X - point.X, lamp.pos.Z - point.Z
		if dx * dx + dz * dz < Config.LAMP_RADIUS * Config.LAMP_RADIUS then
			return true
		end
	end
	return false
end

---------------------------------------------------------------------------
-- Seeing
---------------------------------------------------------------------------
-- True if nothing solid (and no smoke) is between a and b.
local function clearLine(m, a, b)
	for _, s in ipairs(m.smokes) do
		if distToSegment(s.pos, a, b) < s.radius then
			return false
		end
	end
	local origin = Vector3.new(a.X, m.origin.Y + 4.5, a.Z)
	local dir = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	if dir.Magnitude < 0.05 then
		return true
	end
	return workspace:Raycast(origin, dir, m.rayParams) == nil
end

local function canSee(m, g, point, range, cosLimit)
	local v = Vector3.new(point.X - g.pos.X, 0, point.Z - g.pos.Z)
	local d = v.Magnitude
	if d > range then
		return false, d
	end
	if d > 1 and g.look:Dot(v.Unit) < cosLimit then
		return false, d
	end
	if not clearLine(m, g.pos, point) then
		return false, d
	end
	return true, d
end

---------------------------------------------------------------------------
-- Guard movement
---------------------------------------------------------------------------
local function turnToward(g, point, dt)
	local v = Vector3.new(point.X - g.pos.X, 0, point.Z - g.pos.Z)
	if v.Magnitude < 0.05 then
		return
	end
	local mixed = g.look:Lerp(v.Unit, math.min(1, dt * 8))
	if mixed.Magnitude < 0.01 then
		mixed = v.Unit -- looking exactly the opposite way, just snap
	end
	g.look = mixed.Unit
end

-- Walks toward a point. Returns true once the guard is standing on it.
local function moveToward(g, point, speed, dt)
	local v = Vector3.new(point.X - g.pos.X, 0, point.Z - g.pos.Z)
	local dist = v.Magnitude
	if dist < 0.3 then
		return true
	end
	g.pos = g.pos + v.Unit * math.min(dist, speed * dt)
	turnToward(g, point, dt)
	return false
end

local function patrolPoint(m, g)
	local wp = g.spec.points[g.wp]
	return P(m, wp[1], wp[2], GUARD_Y)
end

local function computePath(fromPos, toPos, floorY)
	local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = false })
	local a = Vector3.new(fromPos.X, floorY + 0.5, fromPos.Z)
	local b = Vector3.new(toPos.X, floorY + 0.5, toPos.Z)
	local ok = pcall(function()
		path:ComputeAsync(a, b)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		local points = {}
		for _, wp in ipairs(path:GetWaypoints()) do
			table.insert(points, wp.Position)
		end
		if #points > 0 then
			return points
		end
	end
	return { toPos } -- no path found, walk straight there
end

-- Sends a guard somewhere off their patrol route ("investigate" or "return").
local function setGoal(m, g, point, state)
	g.state = state
	g.path = nil
	g.pathIndex = 1
	g.arrivedAt = nil
	g.token = g.token + 1
	local token = g.token
	task.spawn(function()
		local points = computePath(g.pos, point, m.origin.Y)
		if g.token == token and g.state == state and not g.down then
			g.path = points
		end
	end)
end

-- Follows the current path. Returns true when the guard reaches the end.
local function followPath(m, g, speed, dt)
	if not g.path then
		return false -- still working out the route
	end
	local target = g.path[g.pathIndex]
	if not target then
		return true
	end
	if moveToward(g, Vector3.new(target.X, m.origin.Y + GUARD_Y, target.Z), speed, dt) then
		g.pathIndex = g.pathIndex + 1
	end
	return g.path[g.pathIndex] == nil
end

local function patrolStep(m, g, dt, now)
	if now < g.waitUntil then
		return
	end
	if moveToward(g, patrolPoint(m, g), Config.GUARD_SPEED.patrol, dt) then
		g.waitUntil = now + (g.spec.points[g.wp][3] or 0)
		local n = #g.spec.points
		if g.spec.loop then
			g.wp = g.wp % n + 1
		else
			if g.wp + g.wpDir < 1 or g.wp + g.wpDir > n then
				g.wpDir = -g.wpDir
			end
			g.wp = g.wp + g.wpDir
		end
	end
end

---------------------------------------------------------------------------
-- Mission state changes
---------------------------------------------------------------------------
local function finishMission(m, success, reason)
	if m.state ~= "active" then
		return
	end
	m.state = "done"
	setAttr(m.level, "State", "done")
	local hum = getCharacterParts(m.player)
	if hum then
		hum.WalkSpeed = 0
	end

	local elapsed = os.clock() - m.startClock
	local result = {
		success = success, reason = reason, time = elapsed,
		spotted = m.spotted, bodiesFound = m.bodiesFound, takedowns = m.takedowns,
	}
	if success then
		local score = 100 - 25 * m.spotted - 10 * m.bodiesFound - 5 * m.takedowns
			- math.max(0, math.floor((elapsed - Config.PAR_TIME) / 10))
		score = math.max(0, score)
		local rank = "D"
		if score >= 95 then
			rank = "S"
		elseif score >= 80 then
			rank = "A"
		elseif score >= 60 then
			rank = "B"
		elseif score >= 40 then
			rank = "C"
		end
		result.score = score
		result.rank = rank
		local best = m.player:GetAttribute("BestScore")
		if not best or score > best then
			m.player:SetAttribute("BestScore", score)
			m.player:SetAttribute("BestRank", rank)
		end
	end
	ResultRemote:FireClient(m.player, result)
end

local function startChase(m, g, playerPos, countIt)
	if g.down or g.state == "chase" then
		return
	end
	g.state = "chase"
	g.meter = 1
	g.lastSeen = playerPos
	g.lostAt = nil
	g.path = nil
	g.token = g.token + 1
	if countIt then
		m.spotted = m.spotted + 1
		FxRemote:FireClient(m.player, "Alert", "SPOTTED")
	end
end

local function downGuard(m, g)
	g.down = true
	g.state = "down"
	g.meter = 0
	g.token = g.token + 1
	g.root:SetAttribute("Down", true)
	g.root:SetAttribute("State", "down")
	g.root:SetAttribute("Meter", 0)
	FxRemote:FireClient(m.player, "Takedown", g.pos, g.spec.target == true)
	if g.spec.target then
		m.targetDown = true
		setAttr(m.level, "TargetDown", true)
		setAttr(m.level, "Objective", "Target down. Get back to the exit in the storage room.")
		m.exitPad.Transparency = 0.3
		m.exitBeam.Transparency = 0.75
	else
		m.takedowns = m.takedowns + 1
	end
end

local function resetMission(m)
	m.state = "briefing"
	m.spotted = 0
	m.bodiesFound = 0
	m.takedowns = 0
	m.targetDown = false
	m.smokes = {}
	m.tools = {}
	m.crouching = false
	m.lightsOffUntil = 0
	m.fuseReadyAt = 0
	m.startClock = os.clock()
	setLights(m, true)
	spawnGuards(m)
	m.exitPad.Transparency = 1
	m.exitBeam.Transparency = 1
	setAttr(m.level, "State", "briefing")
	setAttr(m.level, "TargetDown", false)
	setAttr(m.level, "Lit", false)
	setAttr(m.level, "Crouching", false)
	setAttr(m.level, "Objective", "Take out " .. Config.Mission.target .. " without being seen.")
	for _, name in ipairs(Config.ToolOrder) do
		m.level:SetAttribute("Tool_" .. name, nil)
	end

	local hum, _, char = getCharacterParts(m.player)
	if hum then
		hum.UseJumpPower = true
		hum.JumpPower = 0 -- no jumping over cover
		hum.WalkSpeed = 0 -- frozen until the mission starts
		if m.hipHeight then
			hum.HipHeight = m.hipHeight
		end
		char:PivotTo(CFrame.new(P(m, LevelDef.start[1], LevelDef.start[2], 4)))
	end
end

---------------------------------------------------------------------------
-- Guard thinking (runs every frame while a mission is active)
---------------------------------------------------------------------------
local function stepGuard(m, g, dt, now, playerPos, range, noisy)
	if g.state == "chase" then
		local seen = canSee(m, g, playerPos, Config.VIEW_RANGE_LIT * 1.2, CHASE_COS)
		if seen then
			g.lastSeen = playerPos
			g.lostAt = nil
		elseif not g.lostAt then
			g.lostAt = now
		end
		local arrived = moveToward(g, g.lastSeen, Config.GUARD_SPEED.chase, dt)
		if arrived and not seen then
			g.look = CFrame.Angles(0, dt * 2.5, 0) * g.look -- look around
		end
		local d = Vector3.new(playerPos.X - g.pos.X, 0, playerPos.Z - g.pos.Z).Magnitude
		if seen and d < Config.CATCH_RANGE then
			finishMission(m, false, "CAUGHT")
			return
		end
		if g.lostAt and now - g.lostAt > Config.CHASE_GIVE_UP_TIME then
			g.meter = 0
			setGoal(m, g, patrolPoint(m, g), "return")
		end
		return
	end

	-- Detection meter: fills while the guard can see you, drains when they can't.
	local seen, d = canSee(m, g, playerPos, range, VIEW_COS)
	if seen then
		local fillTime = lerp(Config.DETECT_TIME_NEAR, Config.DETECT_TIME_FAR, d / range)
		g.meter = math.min(1, g.meter + dt / fillTime)
		if d < 4 then
			g.meter = 1
		end
	else
		g.meter = math.max(0, g.meter - Config.DETECT_DECAY * dt)
	end

	if g.meter >= 1 then
		if g.spec.target then
			-- The target doesn't chase. He panics and calls every guard nearby.
			m.spotted = m.spotted + 1
			FxRemote:FireClient(m.player, "Alert", "TARGET SAW YOU")
			g.meter = 0
			g.waitUntil = now + 6
			for _, other in ipairs(m.guards) do
				if not other.spec.target and (other.pos - g.pos).Magnitude < 45 then
					startChase(m, other, playerPos, false)
				end
			end
		else
			startChase(m, g, playerPos, true)
		end
		return
	end

	-- Hearing: walking near a patrolling guard makes them come and look.
	if noisy and g.state == "patrol" and not g.spec.target and now > g.noiseReadyAt then
		local nd = Vector3.new(playerPos.X - g.pos.X, 0, playerPos.Z - g.pos.Z).Magnitude
		if nd < Config.NOISE_RADIUS and (nd < 6 or clearLine(m, g.pos, playerPos)) then
			g.noiseReadyAt = now + 6
			setGoal(m, g, playerPos, "investigate")
		end
	end

	if seen and g.meter > 0.35 then
		turnToward(g, playerPos, dt) -- stops and stares at you
	elseif g.state == "patrol" then
		patrolStep(m, g, dt, now)
	elseif g.state == "investigate" then
		if g.arrivedAt then
			g.look = CFrame.Angles(0, dt * 1.8, 0) * g.look
			if now - g.arrivedAt > 3 then
				setGoal(m, g, patrolPoint(m, g), "return")
			end
		elseif followPath(m, g, Config.GUARD_SPEED.investigate, dt) then
			g.arrivedAt = now
		end
	elseif g.state == "return" then
		if followPath(m, g, Config.GUARD_SPEED.patrol, dt) then
			g.state = "patrol"
			g.path = nil
		end
	end
end

local function stepMission(m, dt)
	local now = os.clock()
	local hum, proot = getCharacterParts(m.player)
	if not hum then
		return
	end
	local playerPos = Vector3.new(proot.Position.X, m.origin.Y + GUARD_Y, proot.Position.Z)

	if m.lightsOff and now >= m.lightsOffUntil then
		setLights(m, true)
	end
	for i = #m.smokes, 1, -1 do
		if now >= m.smokes[i].untilTime then
			table.remove(m.smokes, i)
		end
	end

	local lit = isLit(m, playerPos)
	setAttr(m.level, "Lit", lit)
	local range = (lit and Config.VIEW_RANGE_LIT or Config.VIEW_RANGE_DARK)
		* (m.crouching and Config.CROUCH_RANGE_MULT or 1)
	local vel = proot.AssemblyLinearVelocity
	local noisy = (not m.crouching) and Vector3.new(vel.X, 0, vel.Z).Magnitude > 10

	for _, g in ipairs(m.guards) do
		if not g.down then
			stepGuard(m, g, dt, now, playerPos, range, noisy)
			if m.state ~= "active" then
				return
			end
			g.root.CFrame = CFrame.lookAt(g.pos, g.pos + g.look)
			setAttr(g.root, "State", g.state)
			setAttr(g.root, "Meter", math.floor(g.meter * 20 + 0.5) / 20)
		end
	end

	-- Guards who walk past a knocked-out guard notice the body.
	for _, body in ipairs(m.guards) do
		if body.down and not body.found then
			for _, g in ipairs(m.guards) do
				if not g.down and not g.spec.target and (g.state == "patrol" or g.state == "return")
					and canSee(m, g, body.pos, Config.BODY_SIGHT_RANGE, VIEW_COS) then
					body.found = true
					m.bodiesFound = m.bodiesFound + 1
					setGoal(m, g, body.pos, "investigate")
					FxRemote:FireClient(m.player, "Alert", "BODY FOUND")
					break
				end
			end
		end
	end

	if m.targetDown then
		local exit = P(m, LevelDef.exit[1], LevelDef.exit[2], GUARD_Y)
		if (playerPos - exit).Magnitude < 6 then
			finishMission(m, true)
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	for _, m in pairs(missions) do
		if m.state == "active" then
			local ok, err = pcall(stepMission, m, dt)
			if not ok then
				warn("Stealth mission error: " .. tostring(err))
			end
		end
	end
end)

---------------------------------------------------------------------------
-- Player input
---------------------------------------------------------------------------
StartRemote.OnServerEvent:Connect(function(player, loadout)
	local m = missions[player]
	local hum = getCharacterParts(player)
	if not m or m.state ~= "briefing" or not hum then
		return
	end
	m.tools = {}
	local count = 0
	if type(loadout) == "table" then
		for _, name in ipairs(loadout) do
			if type(name) == "string" and Config.Tools[name] and not m.tools[name]
				and count < Config.LOADOUT_SIZE then
				m.tools[name] = Config.Tools[name].uses
				m.level:SetAttribute("Tool_" .. name, m.tools[name])
				count = count + 1
			end
		end
	end
	m.startClock = os.clock()
	m.level:SetAttribute("StartTime", workspace:GetServerTimeNow())
	m.state = "active"
	setAttr(m.level, "State", "active")
	hum.WalkSpeed = Config.WALK_SPEED
end)

CrouchRemote.OnServerEvent:Connect(function(player, crouching)
	local m = missions[player]
	local hum = getCharacterParts(player)
	if not m or m.state ~= "active" or not hum then
		return
	end
	m.crouching = (crouching == true)
	setAttr(m.level, "Crouching", m.crouching)
	hum.WalkSpeed = m.crouching and Config.CROUCH_SPEED or Config.WALK_SPEED
	if m.hipHeight and hum.RigType == Enum.HumanoidRigType.R15 then
		hum.HipHeight = m.crouching and math.max(0.2, m.hipHeight - 1) or m.hipHeight
	end
end)

ActionRemote.OnServerEvent:Connect(function(player)
	local m = missions[player]
	local hum, proot = getCharacterParts(player)
	if not m or m.state ~= "active" or not hum then
		return
	end
	local playerPos = Vector3.new(proot.Position.X, m.origin.Y + GUARD_Y, proot.Position.Z)

	-- Takedown: you have to be close and NOT in front of them.
	local best, bestDist = nil, Config.TAKEDOWN_RANGE
	for _, g in ipairs(m.guards) do
		if not g.down and g.state ~= "chase" then
			local v = playerPos - g.pos
			local d = v.Magnitude
			if d < bestDist and (d < 0.5 or g.look:Dot(v.Unit) < 0.2) then
				best, bestDist = g, d
			end
		end
	end
	if best then
		downGuard(m, best)
		return
	end

	-- Fuse box
	local now = os.clock()
	if (playerPos - Vector3.new(m.fuseBox.Position.X, playerPos.Y, m.fuseBox.Position.Z)).Magnitude < 7 then
		if now >= m.fuseReadyAt and not m.lightsOff then
			m.fuseReadyAt = now + Config.FUSE_BOX_COOLDOWN
			cutPower(m)
		else
			FxRemote:FireClient(player, "Hint", "The fuse box is still resetting.")
		end
	end
end)

ToolRemote.OnServerEvent:Connect(function(player, toolName, aim)
	local m = missions[player]
	local hum, proot = getCharacterParts(player)
	if not m or m.state ~= "active" or not hum or type(toolName) ~= "string" then
		return
	end
	local def = Config.Tools[toolName]
	if not def or not m.tools[toolName] or m.tools[toolName] <= 0 then
		return
	end
	local playerPos = Vector3.new(proot.Position.X, m.origin.Y + GUARD_Y, proot.Position.Z)
	if typeof(aim) ~= "Vector3" or aim.X ~= aim.X or aim.Z ~= aim.Z then
		aim = playerPos + proot.CFrame.LookVector * 18
	end
	aim = Vector3.new(aim.X, playerPos.Y, aim.Z)

	if toolName == "NoiseMaker" then
		local v = aim - playerPos
		if v.Magnitude > def.range then
			aim = playerPos + v.Unit * def.range
		end
		for _, g in ipairs(m.guards) do
			if not g.down and not g.spec.target and g.state ~= "chase"
				and (g.pos - aim).Magnitude < def.hearRadius then
				setGoal(m, g, aim, "investigate")
			end
		end
		FxRemote:FireClient(player, "Noise", aim, def.hearRadius)
	elseif toolName == "Smoke" then
		table.insert(m.smokes, { pos = playerPos, radius = def.radius, untilTime = os.clock() + def.time })
		FxRemote:FireClient(player, "Smoke", playerPos, def.radius, def.time)
	elseif toolName == "Dart" then
		local best, bestDist = nil, def.aimSlack
		for _, g in ipairs(m.guards) do
			local d = (g.pos - aim).Magnitude
			if not g.down and d < bestDist then
				best, bestDist = g, d
			end
		end
		if not best then
			FxRemote:FireClient(player, "Hint", "Aim the dart at a guard.")
			return
		end
		if (best.pos - playerPos).Magnitude > def.range or not clearLine(m, playerPos, best.pos) then
			FxRemote:FireClient(player, "Hint", "No clear shot.")
			return
		end
		FxRemote:FireClient(player, "Dart", playerPos, best.pos)
		downGuard(m, best)
	elseif toolName == "PowerCutter" then
		cutPower(m)
	end

	m.tools[toolName] = m.tools[toolName] - 1
	m.level:SetAttribute("Tool_" .. toolName, m.tools[toolName])
end)

RetryRemote.OnServerEvent:Connect(function(player)
	local m = missions[player]
	if m and m.state == "done" then
		resetMission(m)
	end
end)

---------------------------------------------------------------------------
-- Players joining and leaving
---------------------------------------------------------------------------
local function onCharacter(player, char)
	local m = missions[player]
	if not m then
		return
	end
	local hum = char:WaitForChild("Humanoid", 10)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not hum or not root then
		return
	end
	task.wait(0.3)
	if missions[player] ~= m or player.Character ~= char then
		return
	end
	hum.MaxHealth = math.huge
	hum.Health = math.huge
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	m.hipHeight = hum.HipHeight
	resetMission(m)
end

local function onPlayerAdded(player)
	local slot = 1
	while slots[slot] do
		slot = slot + 1
	end
	slots[slot] = player
	local m = {
		player = player, slot = slot,
		origin = Vector3.new(slot * Config.LEVEL_SPACING, Config.BASE_HEIGHT, 0),
		state = "briefing", guards = {}, smokes = {}, tools = {},
		spotted = 0, bodiesFound = 0, takedowns = 0, lightsOffUntil = 0, fuseReadyAt = 0,
		startClock = os.clock(),
	}
	buildLevel(m)
	missions[player] = m
	resetMission(m)
	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player)
	local m = missions[player]
	if m then
		missions[player] = nil
		slots[m.slot] = nil
		m.level:Destroy()
	end
end)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">StealthProps</string><ProtectedString name="Source"><![CDATA[-- StealthProps (ModuleScript, goes in ServerScriptService next to StealthServer)
-- Builds the furniture and scenery for a level out of detailed parts: crate stacks,
-- bookshelves, server racks, sofas, desks, plants, lamps and the city around the building.
-- None of these parts collide. StealthServer adds one invisible box per prop for that.

local Props = {}

local rng = Random.new(7)

local function rgb(r, g, b)
	return Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255))
end

-- ctx.at(x, z, y) turns level coordinates into a world position. ctx.decor is where parts go.
local function part(ctx, size, x, y, z, color, material, extra)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.Position = ctx.at(x, z, y)
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if size.X < 0.6 or size.Y < 0.3 or size.Z < 0.6 then
		p.CastShadow = false
	end
	for k, v in pairs(extra or {}) do
		p[k] = v
	end
	p.Parent = ctx.decor
	return p
end

-- an upright cylinder
local function cyl(ctx, diameter, height, x, y, z, color, material, extra)
	local p = part(ctx, Vector3.new(height, diameter, diameter), x, y, z, color, material, extra)
	p.Shape = Enum.PartType.Cylinder
	p.CFrame = CFrame.new(p.Position) * CFrame.Angles(0, 0, math.rad(90))
	return p
end

local function ball(ctx, diameter, x, y, z, color, material, extra)
	local p = part(ctx, Vector3.new(diameter, diameter, diameter), x, y, z, color, material, extra)
	p.Shape = Enum.PartType.Ball
	return p
end

-- Lets a builder think in "along the long side" (u) and "across" (v) no matter which way the prop faces.
local function orient(x, z, sx, sz, flip)
	local alongX = sx >= sz
	local o = { len = alongX and sx or sz, wid = alongX and sz or sx }
	local sign = flip and -1 or 1
	function o.pos(u, v)
		v = v * sign
		if alongX then
			return x + u, z + v
		end
		return x + v, z + u
	end
	function o.size(lu, h, lv)
		if alongX then
			return Vector3.new(lu, h, lv)
		end
		return Vector3.new(lv, h, lu)
	end
	return o
end

local WOOD_DARK = rgb(58, 40, 30)
local WOOD = rgb(112, 80, 54)
local METAL_DARK = rgb(34, 36, 42)
local MARBLE = rgb(206, 202, 196)

---------------------------------------------------------------------------
-- Tall props (these block a guard's view)
---------------------------------------------------------------------------
local tall = {}

function tall.crates(ctx, x, z, sx, sz)
	local nx = math.max(1, math.floor(sx / 3 + 0.5))
	local nz = math.max(1, math.floor(sz / 3 + 0.5))
	local cx, cz = sx / nx, sz / nz
	for i = 1, nx do
		for j = 1, nz do
			local px = x - sx / 2 + cx * (i - 0.5)
			local pz = z - sz / 2 + cz * (j - 0.5)
			local tone = rng:NextNumber(0.82, 1.08)
			local wood = rgb(124 * tone, 90 * tone, 58 * tone)
			part(ctx, Vector3.new(cx - 0.2, 3, cz - 0.2), px, 1.5, pz, wood, Enum.Material.WoodPlanks)
			part(ctx, Vector3.new(cx - 0.1, 0.25, cz - 0.1), px, 0.3, pz, WOOD_DARK, Enum.Material.Wood)
			part(ctx, Vector3.new(cx - 0.1, 0.25, cz - 0.1), px, 2.75, pz, WOOD_DARK, Enum.Material.Wood)
			local s = rng:NextNumber(0.72, 0.94)
			local tone2 = rng:NextNumber(0.8, 1.05)
			local w2, d2 = (cx - 0.2) * s, (cz - 0.2) * s
			part(ctx, Vector3.new(w2, 2.6, d2), px, 4.3, pz, rgb(132 * tone2, 98 * tone2, 64 * tone2),
				Enum.Material.WoodPlanks)
			part(ctx, Vector3.new(w2 + 0.1, 0.2, d2 + 0.1), px, 5.5, pz, WOOD_DARK, Enum.Material.Wood)
			-- stencil mark on the lid
			part(ctx, Vector3.new(w2 * 0.5, 0.04, d2 * 0.18), px, 5.62, pz, rgb(200, 60, 50), Enum.Material.SmoothPlastic)
		end
	end
end

function tall.pillar(ctx, x, z, sx, sz)
	part(ctx, Vector3.new(sx + 0.3, 0.5, sz + 0.3), x, 0.25, z, rgb(60, 60, 66), Enum.Material.Marble)
	part(ctx, Vector3.new(sx - 0.5, 6.2, sz - 0.5), x, 3.6, z, MARBLE, Enum.Material.Marble)
	part(ctx, Vector3.new(sx + 0.3, 0.4, sz + 0.3), x, 6.9, z, rgb(60, 60, 66), Enum.Material.Marble)
	part(ctx, Vector3.new(sx - 0.3, 0.12, sz - 0.3), x, 0.9, z, rgb(214, 170, 90), Enum.Material.Metal)
end

function tall.reception(ctx, x, z, sx, sz)
	local o = orient(x, z, sx, sz)
	local px, pz = o.pos(0, o.wid * 0.2)
	part(ctx, o.size(o.len, 3.3, o.wid * 0.6), px, 1.65, pz, WOOD_DARK, Enum.Material.Wood)
	part(ctx, o.size(o.len + 0.3, 0.2, o.wid * 0.6 + 0.3), px, 3.4, pz, MARBLE, Enum.Material.Marble)
	local nx, nz = o.pos(0, o.wid * 0.5 + 0.03)
	part(ctx, o.size(o.len - 1, 0.12, 0.1), nx, 2.2, nz, rgb(255, 190, 110), Enum.Material.Neon)
	-- tall backdrop with a glowing logo bar
	local bx, bz = o.pos(0, -o.wid * 0.35)
	part(ctx, o.size(o.len, 5.8, o.wid * 0.25), bx, 2.9, bz, rgb(28, 30, 38), Enum.Material.SmoothPlastic)
	part(ctx, o.size(o.len * 0.5, 0.5, o.wid * 0.25 + 0.08), bx, 4.6, bz, rgb(255, 80, 80), Enum.Material.Neon)
	part(ctx, o.size(o.len + 0.2, 0.15, o.wid * 0.25 + 0.2), bx, 5.85, bz, rgb(214, 170, 90), Enum.Material.Metal)
	-- monitors on the desk
	for _, u in ipairs({ -o.len * 0.25, o.len * 0.25 }) do
		local mx, mz = o.pos(u, o.wid * 0.15)
		part(ctx, o.size(1.6, 1, 0.12), mx, 4.1, mz, METAL_DARK, Enum.Material.SmoothPlastic)
		part(ctx, o.size(1.4, 0.8, 0.14), mx, 4.1, mz, rgb(90, 190, 255), Enum.Material.Neon)
	end
end

function tall.planter(ctx, x, z, sx, sz)
	part(ctx, Vector3.new(sx, 1.6, sz), x, 0.8, z, rgb(52, 54, 60), Enum.Material.Concrete)
	part(ctx, Vector3.new(sx + 0.2, 0.2, sz + 0.2), x, 1.6, z, rgb(36, 38, 44), Enum.Material.Concrete)
	part(ctx, Vector3.new(sx - 0.4, 0.15, sz - 0.4), x, 1.68, z, rgb(44, 32, 24), Enum.Material.Ground)
	local o = orient(x, z, sx, sz)
	local count = math.max(2, math.floor(o.len / 1.6))
	for i = 1, count do
		local u = -o.len / 2 + o.len * (i - 0.5) / count
		local px, pz = o.pos(u, rng:NextNumber(-0.2, 0.2))
		local height = rng:NextNumber(4.6, 6.2)
		cyl(ctx, 0.22, height - 1.6, px, 1.6 + (height - 1.6) / 2, pz, rgb(70, 52, 36), Enum.Material.Wood)
		for _ = 1, 3 do
			local g = rng:NextNumber(0.75, 1.15)
			ball(ctx, rng:NextNumber(1.5, 2.3), px + rng:NextNumber(-0.5, 0.5), height - rng:NextNumber(0, 1.6),
				pz + rng:NextNumber(-0.4, 0.4), rgb(40 * g, 104 * g, 58 * g), Enum.Material.Grass)
		end
	end
end

function tall.servers(ctx, x, z, sx, sz)
	local o = orient(x, z, sx, sz)
	local count = math.max(1, math.floor(o.len / 2.5 + 0.5))
	local w = o.len / count
	for i = 1, count do
		local u = -o.len / 2 + w * (i - 0.5)
		local px, pz = o.pos(u, 0)
		part(ctx, o.size(w - 0.15, 5.7, o.wid), px, 2.85, pz, rgb(26, 28, 34), Enum.Material.Metal)
		part(ctx, o.size(w - 0.5, 0.08, o.wid - 0.5), px, 5.74, pz, rgb(14, 15, 18), Enum.Material.DiamondPlate)
		for side = -1, 1, 2 do
			local fx, fz = o.pos(u, side * (o.wid / 2 + 0.03))
			part(ctx, o.size(w - 0.5, 4.8, 0.06), fx, 2.9, fz, rgb(12, 13, 16), Enum.Material.SmoothPlastic)
			for row = 1, 5 do
				local led = (rng:NextNumber() < 0.25) and rgb(255, 170, 40) or rgb(60, 255, 130)
				local lx, lz = o.pos(u + rng:NextNumber(-w * 0.25, w * 0.25), side * (o.wid / 2 + 0.07))
				part(ctx, o.size(0.5, 0.1, 0.05), lx, 0.9 + row * 0.8, lz, led, Enum.Material.Neon)
			end
		end
		local tx, tz = o.pos(u, 0)
		part(ctx, o.size(0.4, 0.05, 0.4), tx, 5.8, tz, rgb(60, 255, 130), Enum.Material.Neon)
	end
end

function tall.lockers(ctx, x, z, sx, sz)
	local o = orient(x, z, sx, sz)
	local count = math.max(2, math.floor(o.len / 1.5 + 0.5))
	local w = o.len / count
	for i = 1, count do
		local u = -o.len / 2 + w * (i - 0.5)
		local px, pz = o.pos(u, 0)
		part(ctx, o.size(w - 0.08, 5.7, o.wid), px, 2.85, pz, rgb(64, 84, 104), Enum.Material.Metal)
		for side = -1, 1, 2 do
			local hx, hz = o.pos(u + w * 0.25, side * (o.wid / 2 + 0.04))
			part(ctx, o.size(0.12, 0.5, 0.06), hx, 3, hz, rgb(190, 195, 205), Enum.Material.Metal)
			local vx, vz = o.pos(u, side * (o.wid / 2 + 0.03))
			part(ctx, o.size(w * 0.6, 0.5, 0.05), vx, 4.8, vz, rgb(40, 54, 70), Enum.Material.Metal)
		end
	end
	part(ctx, Vector3.new(sx + 0.1, 0.12, sz + 0.1), x, 5.76, z, rgb(44, 60, 76), Enum.Material.Metal)
end

function tall.bar(ctx, x, z, sx, sz)
	local o = orient(x, z, sx, sz)
	-- back shelf (tall) with bottles, counter in front
	local bx, bz = o.pos(0, -o.wid * 0.3)
	part(ctx, o.size(o.len, 5.7, o.wid * 0.38), bx, 2.85, bz, WOOD_DARK, Enum.Material.Wood)
	part(ctx, o.size(o.len - 0.4, 0.1, o.wid * 0.38 + 0.1), bx, 4.2, bz, rgb(255, 170, 90), Enum.Material.Neon)
	local bottles = { rgb(90, 200, 120), rgb(230, 170, 70), rgb(120, 170, 240), rgb(220, 90, 90), rgb(240, 240, 230) }
	local count = math.floor(o.len / 0.9)
	for i = 1, count do
		local u = -o.len / 2 + o.len * (i - 0.5) / count
		local px, pz = o.pos(u, -o.wid * 0.3)
		local c = bottles[rng:NextInteger(1, #bottles)]
		local h = rng:NextNumber(0.7, 1.1)
		cyl(ctx, 0.32, h, px, 5.7 + h / 2, pz, c, Enum.Material.Glass, { Transparency = 0.25 })
	end
	local cx, cz = o.pos(0, o.wid * 0.22)
	part(ctx, o.size(o.len, 3.3, o.wid * 0.5), cx, 1.65, cz, rgb(74, 52, 38), Enum.Material.Wood)
	part(ctx, o.size(o.len + 0.3, 0.2, o.wid * 0.5 + 0.3), cx, 3.4, cz, rgb(30, 30, 34), Enum.Material.Marble,
		{ Reflectance = 0.15 })
	local rx, rz = o.pos(0, o.wid * 0.5)
	part(ctx, o.size(o.len, 0.1, 0.08), rx, 0.5, rz, rgb(214, 170, 90), Enum.Material.Metal)
end

function tall.screen(ctx, x, z, sx, sz)
	local o = orient(x, z, sx, sz)
	local slats = math.floor(o.len / 0.7)
	for i = 1, slats do
		local u = -o.len / 2 + o.len * (i - 0.5) / slats
		local px, pz = o.pos(u, 0)
		part(ctx, o.size(0.28, 5.4, o.wid * 0.5), px, 2.9, pz, WOOD, Enum.Material.Wood)
	end
	part(ctx, o.size(o.len, 0.25, o.wid * 0.7), x, 0.2, z, WOOD_DARK, Enum.Material.Wood)
	part(ctx, o.size(o.len, 0.25, o.wid * 0.7), x, 5.6, z, WOOD_DARK, Enum.Material.Wood)
end

function tall.bookshelf(ctx, x, z, sx, sz)
	local o = orient(x, z, sx, sz)
	part(ctx, o.size(o.len, 5.7, o.wid), x, 2.85, z, WOOD_DARK, Enum.Material.Wood)
	part(ctx, o.size(o.len + 0.2, 0.15, o.wid + 0.2), x, 5.78, z, rgb(40, 28, 22), Enum.Material.Wood)
	local colors = { rgb(150, 40, 40), rgb(40, 70, 120), rgb(50, 100, 70), rgb(190, 160, 90), rgb(90, 60, 110), rgb(200, 200, 190) }
	for side = -1, 1, 2 do
		for row = 1, 4 do
			local u = -o.len / 2 + 0.3
			while u < o.len / 2 - 0.5 do
				local w = rng:NextNumber(0.25, 0.5)
				local h = rng:NextNumber(0.7, 1)
				local px, pz = o.pos(u + w / 2, side * (o.wid / 2 + 0.02))
				part(ctx, o.size(w - 0.04, h, 0.12), px, 0.45 + (row - 1) * 1.3 + h / 2, pz,
					colors[rng:NextInteger(1, #colors)], Enum.Material.SmoothPlastic)
				u = u + w
				if rng:NextNumber() < 0.12 then
					u = u + 0.5 -- a gap on the shelf
				end
			end
		end
	end
end

function tall.cabinet(ctx, x, z, sx, sz)
	local o = orient(x, z, sx, sz)
	local count = math.max(2, math.floor(o.len / 2 + 0.5))
	local w = o.len / count
	for i = 1, count do
		local u = -o.len / 2 + w * (i - 0.5)
		local px, pz = o.pos(u, 0)
		part(ctx, o.size(w - 0.1, 5.7, o.wid), px, 2.85, pz, rgb(92, 96, 104), Enum.Material.Metal)
		for side = -1, 1, 2 do
			for row = 1, 4 do
				local hx, hz = o.pos(u, side * (o.wid / 2 + 0.04))
				part(ctx, o.size(w * 0.5, 0.12, 0.06), hx, row * 1.3, hz, rgb(200, 204, 212), Enum.Material.Metal)
			end
		end
	end
end

---------------------------------------------------------------------------
-- Low props (you can't walk through them, but guards see over them)
---------------------------------------------------------------------------
local low = {}

function low.desk(ctx, x, z, sx, sz, flip)
	local o = orient(x, z, sx, sz, flip)
	part(ctx, o.size(o.len, 0.25, o.wid), x, 2.75, z, rgb(66, 44, 32), Enum.Material.Wood, { Reflectance = 0.08 })
	for _, u in ipairs({ -o.len / 2 + 1.1, o.len / 2 - 1.1 }) do
		local px, pz = o.pos(u, 0)
		part(ctx, o.size(1.8, 2.6, o.wid - 0.4), px, 1.3, pz, WOOD_DARK, Enum.Material.Wood)
	end
	-- laptop, papers, desk lamp
	local lx, lz = o.pos(0, 0.2)
	part(ctx, o.size(1.4, 0.06, 0.9), lx, 2.92, lz, METAL_DARK, Enum.Material.Metal)
	local sxp, szp = o.pos(0, -0.3)
	part(ctx, o.size(1.4, 0.9, 0.06), sxp, 3.35, szp, rgb(120, 200, 255), Enum.Material.Neon)
	local px, pz = o.pos(-o.len * 0.28, 0.1)
	part(ctx, o.size(0.9, 0.03, 1.2), px, 2.9, pz, rgb(235, 232, 220), Enum.Material.SmoothPlastic)
	local dx, dz = o.pos(o.len * 0.32, -0.3)
	cyl(ctx, 0.5, 0.1, dx, 2.92, dz, METAL_DARK, Enum.Material.Metal)
	cyl(ctx, 0.1, 0.9, dx, 3.35, dz, METAL_DARK, Enum.Material.Metal)
	cyl(ctx, 0.6, 0.3, dx, 3.9, dz, rgb(255, 214, 150), Enum.Material.Neon)
	-- chair behind the desk
	local cx, cz = o.pos(0, o.wid / 2 + 1.3)
	part(ctx, o.size(1.8, 0.3, 1.8), cx, 1.7, cz, rgb(30, 30, 34), Enum.Material.Fabric)
	local bx, bz = o.pos(0, o.wid / 2 + 2.1)
	part(ctx, o.size(1.8, 2.4, 0.3), bx, 2.8, bz, rgb(30, 30, 34), Enum.Material.Fabric)
	cyl(ctx, 0.3, 1.5, cx, 0.8, cz, METAL_DARK, Enum.Material.Metal)
end

function low.sofa(ctx, x, z, sx, sz, flip)
	local o = orient(x, z, sx, sz, flip)
	local fabric = rgb(86, 34, 40)
	part(ctx, o.size(o.len, 1.2, o.wid), x, 0.7, z, rgb(40, 22, 24), Enum.Material.Fabric)
	local bx, bz = o.pos(0, -o.wid / 2 + 0.35)
	part(ctx, o.size(o.len, 1.8, 0.7), bx, 2.1, bz, fabric, Enum.Material.Fabric)
	for _, u in ipairs({ -o.len / 2 + 0.35, o.len / 2 - 0.35 }) do
		local ax, az = o.pos(u, 0)
		part(ctx, o.size(0.7, 1, o.wid), ax, 1.7, az, fabric, Enum.Material.Fabric)
	end
	local seats = math.max(2, math.floor((o.len - 1.4) / 2.2 + 0.5))
	local w = (o.len - 1.4) / seats
	for i = 1, seats do
		local u = -(o.len - 1.4) / 2 + w * (i - 0.5)
		local cx, cz = o.pos(u, 0.3)
		part(ctx, o.size(w - 0.12, 0.45, o.wid - 0.9), cx, 1.5, cz, rgb(104, 42, 48), Enum.Material.Fabric)
	end
end

function low.table(ctx, x, z, sx, sz)
	part(ctx, Vector3.new(sx, 0.2, sz), x, 1.5, z, rgb(24, 24, 28), Enum.Material.Glass, { Reflectance = 0.2 })
	part(ctx, Vector3.new(sx - 0.8, 1.3, sz - 0.8), x, 0.75, z, WOOD_DARK, Enum.Material.Wood)
	cyl(ctx, 0.5, 0.5, x - sx * 0.2, 1.85, z, rgb(214, 170, 90), Enum.Material.Metal)
	part(ctx, Vector3.new(1, 0.08, 0.7), x + sx * 0.2, 1.64, z + 0.2, rgb(150, 40, 40), Enum.Material.SmoothPlastic)
end

function low.bench(ctx, x, z, sx, sz)
	local o = orient(x, z, sx, sz)
	part(ctx, o.size(o.len, 0.4, o.wid), x, 1.5, z, rgb(40, 40, 46), Enum.Material.Fabric)
	for _, u in ipairs({ -o.len / 2 + 0.5, o.len / 2 - 0.5 }) do
		local px, pz = o.pos(u, 0)
		part(ctx, o.size(0.3, 1.3, o.wid - 0.4), px, 0.65, pz, rgb(214, 170, 90), Enum.Material.Metal)
	end
end

function low.pallet(ctx, x, z, sx, sz)
	part(ctx, Vector3.new(sx, 0.4, sz), x, 0.2, z, WOOD, Enum.Material.WoodPlanks)
	for i = -1, 1 do
		local tone = rng:NextNumber(0.85, 1.1)
		part(ctx, Vector3.new(sx * 0.28, 1.6, sz * 0.8), x + i * sx * 0.31, 1.2, z,
			rgb(150 * tone, 130 * tone, 96 * tone), Enum.Material.Fabric)
	end
	part(ctx, Vector3.new(sx * 0.9, 0.1, 0.25), x, 2.05, z, rgb(30, 30, 30), Enum.Material.Fabric)
end

function low.console(ctx, x, z, sx, sz, flip)
	local o = orient(x, z, sx, sz, flip)
	part(ctx, o.size(o.len, 2.5, o.wid), x, 1.25, z, rgb(34, 36, 44), Enum.Material.Metal)
	part(ctx, o.size(o.len + 0.2, 0.15, o.wid + 0.2), x, 2.55, z, rgb(20, 21, 26), Enum.Material.SmoothPlastic)
	local count = math.max(2, math.floor(o.len / 2.4))
	for i = 1, count do
		local u = -o.len / 2 + o.len * (i - 0.5) / count
		local px, pz = o.pos(u, -o.wid * 0.25)
		part(ctx, o.size(1.9, 1.3, 0.12), px, 3.4, pz, METAL_DARK, Enum.Material.SmoothPlastic)
		local tint = (i % 2 == 0) and rgb(90, 255, 160) or rgb(90, 190, 255)
		part(ctx, o.size(1.7, 1.1, 0.14), px, 3.4, pz, tint, Enum.Material.Neon)
		local kx, kz = o.pos(u, o.wid * 0.2)
		part(ctx, o.size(1.3, 0.06, 0.5), kx, 2.66, kz, rgb(12, 12, 14), Enum.Material.SmoothPlastic)
	end
end

function low.lounger(ctx, x, z, sx, sz)
	local o = orient(x, z, sx, sz)
	part(ctx, o.size(o.len, 0.4, o.wid), x, 1, z, rgb(226, 222, 212), Enum.Material.Fabric)
	local hx, hz = o.pos(-o.len / 2 + 0.9, 0)
	part(ctx, o.size(1.8, 0.4, o.wid), hx, 1.6, hz, rgb(226, 222, 212), Enum.Material.Fabric)
	part(ctx, o.size(o.len - 0.4, 0.8, o.wid - 0.4), x, 0.4, z, WOOD_DARK, Enum.Material.Wood)
end

---------------------------------------------------------------------------
-- Public
---------------------------------------------------------------------------
function Props.buildTall(ctx, kind, x, z, sx, sz, flip)
	local builder = tall[kind] or tall.crates
	builder(ctx, x, z, sx, sz, flip)
end

function Props.buildLow(ctx, kind, x, z, sx, sz, flip)
	local builder = low[kind] or low.table
	builder(ctx, x, z, sx, sz, flip)
end

-- A floor lamp. Returns the glowing shade and its light so the server can switch it off.
function Props.lamp(ctx, x, z, radius)
	cyl(ctx, 1.6, 0.2, x, 0.1, z, METAL_DARK, Enum.Material.Metal)
	cyl(ctx, 0.22, 6, x, 3.1, z, rgb(214, 170, 90), Enum.Material.Metal)
	local shade = cyl(ctx, 2.1, 1.3, x, 6.6, z, rgb(255, 214, 150), Enum.Material.Neon)
	cyl(ctx, 2.25, 0.12, x, 7.3, z, METAL_DARK, Enum.Material.Metal)
	local light = Instance.new("PointLight")
	light.Range = radius + 6
	light.Brightness = 1.7
	light.Color = rgb(255, 214, 150)
	light.Shadows = true
	light.Parent = shade
	return shade, light
end

function Props.fuseBox(ctx, x, z)
	part(ctx, Vector3.new(1.1, 4.2, 3.2), x, 3, z, rgb(210, 172, 40), Enum.Material.Metal)
	part(ctx, Vector3.new(0.1, 3.4, 2.4), x - 0.6, 3, z, rgb(60, 60, 64), Enum.Material.Metal)
	for i = -1, 1 do
		part(ctx, Vector3.new(0.12, 0.3, 2.4), x - 0.62, 3 + i * 1.2, z, rgb(20, 20, 20), Enum.Material.SmoothPlastic)
	end
	local lamp = part(ctx, Vector3.new(0.15, 0.3, 0.3), x - 0.66, 4.7, z + 0.8, rgb(90, 255, 120), Enum.Material.Neon)
	cyl(ctx, 0.3, 2.4, x, 6.2, z, rgb(80, 82, 88), Enum.Material.Metal)
	return lamp
end

-- Dark towers with lit windows around and below the penthouse, so the edges of the map aren't empty.
function Props.skyline(ctx, halfWidth, halfDepth)
	part(ctx, Vector3.new(900, 2, 800), 0, -160, 0, rgb(8, 9, 14), Enum.Material.Asphalt)
	for i = -3, 3 do
		part(ctx, Vector3.new(900, 0.3, 3), 0, -158.8, i * 90, rgb(255, 160, 70), Enum.Material.Neon, { Transparency = 0.3 })
		part(ctx, Vector3.new(3, 0.3, 800), i * 110, -158.8, 0, rgb(255, 160, 70), Enum.Material.Neon, { Transparency = 0.3 })
	end
	local built = 0
	local tries = 0
	while built < 64 and tries < 400 do
		tries = tries + 1
		local x = rng:NextNumber(-300, 300)
		local z = rng:NextNumber(-260, 260)
		if math.abs(x) > halfWidth + 24 or math.abs(z) > halfDepth + 24 then
			built = built + 1
			local w = rng:NextNumber(26, 54)
			local d = rng:NextNumber(26, 54)
			local top = -rng:NextNumber(10, 90)
			local height = 160 + top
			local tone = rng:NextNumber(0.8, 1.3)
			part(ctx, Vector3.new(w, height, d), x, top - height / 2, z, rgb(20 * tone, 22 * tone, 30 * tone),
				Enum.Material.Concrete)
			-- roof details you see from above
			part(ctx, Vector3.new(w - 3, 0.6, d - 3), x, top + 0.3, z, rgb(14, 15, 20), Enum.Material.Concrete)
			part(ctx, Vector3.new(w * 0.25, 3, d * 0.2), x + w * 0.2, top + 1.5, z - d * 0.2, rgb(40, 42, 50), Enum.Material.Metal)
			if rng:NextNumber() < 0.5 then
				local glow = (rng:NextNumber() < 0.5) and rgb(255, 70, 90) or rgb(80, 200, 255)
				part(ctx, Vector3.new(w * 0.5, 0.3, 0.6), x - w * 0.1, top + 0.8, z + d * 0.3, glow, Enum.Material.Neon)
			end
			if rng:NextNumber() < 0.4 then
				ball(ctx, 1.2, x - w * 0.4, top + 4, z - d * 0.4, rgb(255, 40, 40), Enum.Material.Neon)
			end
			-- window bands on the side facing the camera
			for band = 1, 3 do
				local warm = rng:NextNumber() < 0.7
				part(ctx, Vector3.new(w * rng:NextNumber(0.4, 0.85), 1.2, 0.3), x, top - band * rng:NextNumber(7, 11), z + d / 2,
					warm and rgb(255, 206, 130) or rgb(140, 200, 255), Enum.Material.Neon, { Transparency = 0.2 })
			end
		end
	end
end

return Props
]]></ProtectedString></Properties></Item>
</Item>
<Item class="StarterPlayer" referent="RBX10"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX9"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX7"><Properties><string name="Name">StealthClient</string><ProtectedString name="Source"><![CDATA[-- StealthClient (LocalScript, goes in StarterPlayer > StarterPlayerScripts)
-- What the player sees and presses: the overhead camera, guard vision cones,
-- the HUD, the briefing and results screens, and effects. It never decides
-- whether you were seen. The server does that.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Config = require(ReplicatedStorage:WaitForChild("StealthConfig"))
local remotes = ReplicatedStorage:WaitForChild("StealthRemotes")
local StartRemote = remotes:WaitForChild("Start")
local ActionRemote = remotes:WaitForChild("Action")
local ToolRemote = remotes:WaitForChild("UseTool")
local CrouchRemote = remotes:WaitForChild("Crouch")
local RetryRemote = remotes:WaitForChild("Retry")
local ResultRemote = remotes:WaitForChild("Result")
local FxRemote = remotes:WaitForChild("Fx")

local level = workspace:WaitForChild("Level_" .. player.UserId)
local guardsFolder = level:WaitForChild("Guards")
local solid = level:WaitForChild("Solid")
local origin = level:GetAttribute("Origin")

local FONT = Enum.Font.GothamBold
local FONT_LIGHT = Enum.Font.Gotham
local HALF_ANGLE = math.rad(Config.VIEW_HALF_ANGLE)

local fxFolder = Instance.new("Folder")
fxFolder.Name = "StealthFx"
fxFolder.Parent = workspace

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include
rayParams.FilterDescendantsInstances = { solid }

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local function make(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props) do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

local function myRoot()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function playSound(id, volume)
	local s = make("Sound", { SoundId = id, Volume = volume or 0.5 }, fxFolder)
	s:Play()
	Debris:AddItem(s, 3)
end

local function formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

---------------------------------------------------------------------------
-- HUD
---------------------------------------------------------------------------
local gui = make("ScreenGui", {
	Name = "StealthHud", ResetOnSpawn = false, IgnoreGuiInset = true,
}, player:WaitForChild("PlayerGui"))

local function label(props, parent)
	local base = {
		BackgroundTransparency = 1, Font = FONT, TextColor3 = Color3.new(1, 1, 1),
		TextSize = 16, TextStrokeTransparency = 0.6, Text = "",
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return make("TextLabel", base, parent or gui)
end

local function panel(props, parent)
	local base = {
		BackgroundColor3 = Color3.fromRGB(14, 16, 24), BackgroundTransparency = 0.12, BorderSizePixel = 0,
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	local frame = make("Frame", base, parent or gui)
	make("UICorner", { CornerRadius = UDim.new(0, 10) }, frame)
	make("UIStroke", { Color = Color3.fromRGB(70, 76, 100), Thickness = 1 }, frame)
	return frame
end

local missionLabel = label({
	Position = UDim2.new(0, 20, 0, 52), Size = UDim2.new(0, 400, 0, 22), TextSize = 20,
	TextXAlignment = Enum.TextXAlignment.Left, Text = Config.Mission.name,
})
local objectiveLabel = label({
	Position = UDim2.new(0, 20, 0, 76), Size = UDim2.new(0, 520, 0, 20), Font = FONT_LIGHT,
	TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(215, 220, 235),
})
local timerLabel = label({
	AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 50),
	Size = UDim2.new(0, 120, 0, 34), TextSize = 30, Text = "0:00",
})
local statusLabel = label({
	AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -62),
	Size = UDim2.new(0, 300, 0, 28), TextSize = 22,
})
local promptLabel = label({
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.66, 0),
	Size = UDim2.new(0, 400, 0, 30), TextSize = 22, TextColor3 = Color3.fromRGB(255, 225, 120),
})
local hintLabel = label({
	AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -100),
	Size = UDim2.new(0.8, 0, 0, 24), TextSize = 18, TextColor3 = Color3.fromRGB(255, 190, 120),
})
local controlsLabel = label({
	AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12),
	Size = UDim2.new(0.96, 0, 0, 20), Font = FONT_LIGHT, TextSize = 14,
	TextColor3 = Color3.fromRGB(190, 195, 210),
	Text = "WASD move    C crouch (quiet, harder to see)    E takedown from behind / use    Q and R tools (aim with mouse)",
})
local alertLabel = label({
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.26, 0),
	Size = UDim2.new(0.8, 0, 0, 60), TextSize = 48, TextColor3 = Color3.fromRGB(255, 70, 70),
	TextStrokeTransparency = 0, Visible = false,
})
local flash = make("Frame", {
	Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(255, 40, 40),
	BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5,
}, gui)

-- Tool slots (bottom right)
local toolSlots = {}
for i = 1, Config.LOADOUT_SIZE do
	local frame = panel({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -20 - (Config.LOADOUT_SIZE - i) * 170, 1, -44),
		Size = UDim2.new(0, 160, 0, 54), Visible = false,
	})
	local nameLabel = label({
		Position = UDim2.new(0, 10, 0, 6), Size = UDim2.new(1, -20, 0, 20),
		TextXAlignment = Enum.TextXAlignment.Left,
	}, frame)
	local countLabel = label({
		Position = UDim2.new(0, 10, 0, 28), Size = UDim2.new(1, -20, 0, 18), Font = FONT_LIGHT,
		TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(190, 195, 210),
	}, frame)
	toolSlots[i] = { frame = frame, name = nameLabel, count = countLabel }
end
local TOOL_KEYS = { "Q", "R" }

---------------------------------------------------------------------------
-- Briefing screen
---------------------------------------------------------------------------
local selected = {} -- tool names in the order they were picked

local briefing = panel({
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
	Size = UDim2.new(0, 520, 0, 470), Visible = false,
})
label({
	Position = UDim2.new(0, 24, 0, 18), Size = UDim2.new(1, -48, 0, 18), TextSize = 14,
	TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(255, 90, 90), Text = "CONTRACT",
}, briefing)
label({
	Position = UDim2.new(0, 24, 0, 38), Size = UDim2.new(1, -48, 0, 32), TextSize = 30,
	TextXAlignment = Enum.TextXAlignment.Left, Text = Config.Mission.name,
}, briefing)
label({
	Position = UDim2.new(0, 24, 0, 76), Size = UDim2.new(1, -48, 0, 20),
	TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(255, 200, 60),
	Text = "Target: " .. Config.Mission.target .. " (red suit)",
}, briefing)
label({
	Position = UDim2.new(0, 24, 0, 102), Size = UDim2.new(1, -48, 0, 92), Font = FONT_LIGHT, TextSize = 15,
	TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
	TextColor3 = Color3.fromRGB(215, 220, 235), Text = Config.Mission.briefing,
}, briefing)
local pickTitle = label({
	Position = UDim2.new(0, 24, 0, 200), Size = UDim2.new(1, -48, 0, 20),
	TextXAlignment = Enum.TextXAlignment.Left,
}, briefing)

local toolButtons = {}
local function refreshToolButtons()
	pickTitle.Text = "PICK " .. Config.LOADOUT_SIZE .. " TOOLS  (" .. #selected .. "/" .. Config.LOADOUT_SIZE .. ")"
	for name, button in pairs(toolButtons) do
		local on = table.find(selected, name) ~= nil
		button.BackgroundColor3 = on and Color3.fromRGB(190, 40, 50) or Color3.fromRGB(34, 38, 54)
	end
end
for i, name in ipairs(Config.ToolOrder) do
	local def = Config.Tools[name]
	local button = make("TextButton", {
		Position = UDim2.new(0, 24, 0, 226 + (i - 1) * 46), Size = UDim2.new(1, -48, 0, 40),
		BackgroundColor3 = Color3.fromRGB(34, 38, 54), BorderSizePixel = 0, Text = "", AutoButtonColor = true,
	}, briefing)
	make("UICorner", { CornerRadius = UDim.new(0, 6) }, button)
	label({
		Position = UDim2.new(0, 10, 0, 2), Size = UDim2.new(1, -20, 0, 18),
		TextXAlignment = Enum.TextXAlignment.Left, Text = def.name .. "  x" .. def.uses,
	}, button)
	label({
		Position = UDim2.new(0, 10, 0, 20), Size = UDim2.new(1, -20, 0, 16), Font = FONT_LIGHT, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(200, 205, 220),
		Text = def.description,
	}, button)
	toolButtons[name] = button
	button.Activated:Connect(function()
		local at = table.find(selected, name)
		if at then
			table.remove(selected, at)
		elseif #selected < Config.LOADOUT_SIZE then
			table.insert(selected, name)
		end
		refreshToolButtons()
	end)
end
refreshToolButtons()

local startButton = make("TextButton", {
	AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18),
	Size = UDim2.new(0, 220, 0, 42), BackgroundColor3 = Color3.fromRGB(210, 45, 55), BorderSizePixel = 0,
	Font = FONT, TextSize = 20, TextColor3 = Color3.new(1, 1, 1), Text = "START MISSION",
}, briefing)
make("UICorner", { CornerRadius = UDim.new(0, 8) }, startButton)
startButton.Activated:Connect(function()
	StartRemote:FireServer(selected)
end)

---------------------------------------------------------------------------
-- Results screen
---------------------------------------------------------------------------
local results = panel({
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
	Size = UDim2.new(0, 420, 0, 380), Visible = false,
})
local resultTitle = label({
	Position = UDim2.new(0, 0, 0, 18), Size = UDim2.new(1, 0, 0, 30), TextSize = 26,
}, results)
local rankLabel = label({
	Position = UDim2.new(0, 0, 0, 52), Size = UDim2.new(1, 0, 0, 110), TextSize = 110,
	TextColor3 = Color3.fromRGB(255, 200, 60),
}, results)
local statsLabel = label({
	Position = UDim2.new(0, 40, 0, 172), Size = UDim2.new(1, -80, 0, 130), Font = FONT_LIGHT, TextSize = 17,
	TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
	TextColor3 = Color3.fromRGB(215, 220, 235),
}, results)
local retryButton = make("TextButton", {
	AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, -98, 1, -18),
	Size = UDim2.new(0, 184, 0, 42), BackgroundColor3 = Color3.fromRGB(210, 45, 55), BorderSizePixel = 0,
	Font = FONT, TextSize = 20, TextColor3 = Color3.new(1, 1, 1), Text = "PLAY AGAIN",
}, results)
make("UICorner", { CornerRadius = UDim.new(0, 8) }, retryButton)
retryButton.Activated:Connect(function()
	results.Visible = false
	RetryRemote:FireServer()
end)
local menuButton = make("TextButton", {
	AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 98, 1, -18),
	Size = UDim2.new(0, 184, 0, 42), BackgroundColor3 = Color3.fromRGB(40, 44, 62), BorderSizePixel = 0,
	Font = FONT, TextSize = 20, TextColor3 = Color3.new(1, 1, 1), Text = "MAIN MENU",
}, results)
make("UICorner", { CornerRadius = UDim.new(0, 8) }, menuButton)
menuButton.Activated:Connect(function()
	results.Visible = false
	RetryRemote:FireServer()
	player:SetAttribute("InMenu", true) -- StealthMenu sees this and takes the camera back
end)

ResultRemote.OnClientEvent:Connect(function(r)
	if r.success then
		resultTitle.Text = "CONTRACT COMPLETE"
		resultTitle.TextColor3 = Color3.fromRGB(120, 255, 160)
		rankLabel.Text = r.rank
		statsLabel.Text = "Time: " .. formatTime(r.time) .. "  (par " .. formatTime(Config.PAR_TIME) .. ")"
			.. "\nTimes spotted: " .. r.spotted
			.. "\nBodies found: " .. r.bodiesFound
			.. "\nExtra takedowns: " .. r.takedowns
			.. "\nScore: " .. r.score .. " / 100"
	else
		resultTitle.Text = "CONTRACT FAILED"
		resultTitle.TextColor3 = Color3.fromRGB(255, 90, 90)
		rankLabel.Text = "X"
		statsLabel.Text = "You were " .. string.lower(r.reason or "caught") .. "."
			.. "\nTime: " .. formatTime(r.time)
			.. "\n\nTip: stay out of the light, crouch near guards, and come at them from behind."
	end
	results.Visible = true
end)

---------------------------------------------------------------------------
-- Controls
---------------------------------------------------------------------------
local crouching = false

local function isActive()
	return level:GetAttribute("State") == "active"
end

-- Where the mouse points on the floor. Without a mouse, a spot in front of the character.
local function aimPoint()
	local root = myRoot()
	if not root then
		return nil
	end
	if UserInputService.MouseEnabled then
		local loc = UserInputService:GetMouseLocation()
		local ray = camera:ViewportPointToRay(loc.X, loc.Y)
		if ray.Direction.Y < -0.01 then
			local t = (origin.Y + 3 - ray.Origin.Y) / ray.Direction.Y
			return ray.Origin + ray.Direction * t
		end
	end
	return root.Position + root.CFrame.LookVector * 18
end

local function useTool(slot)
	local name = selected[slot]
	if name and (level:GetAttribute("Tool_" .. name) or 0) > 0 then
		ToolRemote:FireServer(name, aimPoint())
	end
end

local function onAction(actionName, inputState)
	if inputState ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Pass
	end
	if not isActive() then
		return Enum.ContextActionResult.Pass
	end
	if actionName == "StealthCrouch" then
		crouching = not crouching
		CrouchRemote:FireServer(crouching)
	elseif actionName == "StealthAction" then
		ActionRemote:FireServer()
	elseif actionName == "StealthTool1" then
		useTool(1)
	elseif actionName == "StealthTool2" then
		useTool(2)
	end
	return Enum.ContextActionResult.Sink
end

local binds = {
	{ "StealthCrouch", "Crouch", UDim2.new(0.05, 0, 0.5, 0), Enum.KeyCode.C, Enum.KeyCode.ButtonB },
	{ "StealthAction", "Action", UDim2.new(0.35, 0, 0.5, 0), Enum.KeyCode.E, Enum.KeyCode.ButtonX },
	{ "StealthTool1", "Tool 1", UDim2.new(0.05, 0, 0.15, 0), Enum.KeyCode.Q, Enum.KeyCode.ButtonL1 },
	{ "StealthTool2", "Tool 2", UDim2.new(0.35, 0, 0.15, 0), Enum.KeyCode.R, Enum.KeyCode.ButtonR1 },
}
for _, b in ipairs(binds) do
	ContextActionService:BindAction(b[1], onAction, true, b[4], b[5])
	ContextActionService:SetTitle(b[1], b[2])
	ContextActionService:SetPosition(b[1], b[3])
end

---------------------------------------------------------------------------
-- Guard visuals: animated characters, vision cones, markers and speech
---------------------------------------------------------------------------
local visuals = {}
local rigsFolder = ReplicatedStorage:WaitForChild("StealthRigs", 10)
local CONE_SEGMENTS = 14
local CONE_THICKNESS = 0.04
-- Roblox's own default R15 animations
local ANIMATIONS = {
	idle = "rbxassetid://507766388",
	walk = "rbxassetid://507777826",
	run = "rbxassetid://507767714",
}

-- Welds an extra piece (cap, vest, tie...) onto part of a character.
local function attach(rig, limbName, size, offset, color, material, cylinder)
	local limb = rig:FindFirstChild(limbName)
	if not limb then
		return nil
	end
	local p = make("Part", {
		Size = size, Color = color, Material = material or Enum.Material.SmoothPlastic,
		CanCollide = false, CanQuery = false, CanTouch = false, Massless = true,
		TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth,
		CFrame = limb.CFrame * offset,
	}, rig)
	pcall(function()
		p.CollisionGroup = "StealthGhost"
	end)
	if cylinder then
		p.Shape = Enum.PartType.Cylinder
	end
	make("WeldConstraint", { Part0 = limb, Part1 = p }, p)
	return p
end

local function dressRig(rig, isTarget)
	local torso = rig:FindFirstChild("UpperTorso")
	local hips = rig:FindFirstChild("LowerTorso")
	local head = rig:FindFirstChild("Head")
	if not (torso and head) then
		return
	end
	local front = -(torso.Size.Z / 2)
	local headWidth = math.min(head.Size.X, head.Size.Z) + 0.2
	if isTarget then
		-- white shirt, gold tie, slick hair
		attach(rig, "UpperTorso", Vector3.new(0.62, torso.Size.Y * 0.82, 0.04), CFrame.new(0, 0.05, front - 0.02),
			Color3.fromRGB(238, 236, 228))
		attach(rig, "UpperTorso", Vector3.new(0.22, torso.Size.Y * 0.74, 0.05), CFrame.new(0, 0.02, front - 0.05),
			Color3.fromRGB(255, 200, 60), Enum.Material.Neon)
		attach(rig, "Head", Vector3.new(headWidth, 0.32, headWidth), CFrame.new(0, head.Size.Y / 2 + 0.06, 0.05),
			Color3.fromRGB(38, 28, 22))
	else
		-- dark vest with a chest light, belt, and a cap
		attach(rig, "UpperTorso", torso.Size + Vector3.new(0.14, 0.04, 0.16), CFrame.new(),
			Color3.fromRGB(20, 22, 30), Enum.Material.Fabric)
		attach(rig, "UpperTorso", Vector3.new(0.6, 0.14, 0.06), CFrame.new(0.32, 0.28, front - 0.1),
			Color3.fromRGB(90, 220, 255), Enum.Material.Neon)
		if hips then
			attach(rig, "LowerTorso", Vector3.new(hips.Size.X + 0.14, 0.22, hips.Size.Z + 0.16),
				CFrame.new(0, hips.Size.Y / 2 - 0.1, 0), Color3.fromRGB(10, 10, 12))
			attach(rig, "LowerTorso", Vector3.new(0.3, 0.2, 0.06),
				CFrame.new(0, hips.Size.Y / 2 - 0.1, -(hips.Size.Z / 2 + 0.1)), Color3.fromRGB(214, 170, 90), Enum.Material.Metal)
		end
		attach(rig, "Head", Vector3.new(0.4, headWidth, headWidth),
			CFrame.new(0, head.Size.Y / 2 + 0.1, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Color3.fromRGB(22, 28, 48), Enum.Material.Fabric, true)
		attach(rig, "Head", Vector3.new(headWidth * 0.9, 0.08, 0.5),
			CFrame.new(0, head.Size.Y / 2 - 0.04, -(headWidth / 2 + 0.1)), Color3.fromRGB(22, 28, 48), Enum.Material.Fabric)
	end
end

-- Returns the character model, its animation tracks, and how much higher than the
-- server's Root its middle sits.
local function buildRig(isTarget, cf)
	local template = rigsFolder and rigsFolder:FindFirstChild(isTarget and "TargetRig" or "GuardRig")
	if template then
		local rig = template:Clone()
		local hum = rig:FindFirstChildOfClass("Humanoid")
		local hrp = rig:FindFirstChild("HumanoidRootPart")
		if hum and hrp then
			for _, d in ipairs(rig:GetDescendants()) do
				if d:IsA("BasePart") then
					d.CanCollide = false
					d.CanQuery = false
					d.CanTouch = false
					pcall(function()
						d.CollisionGroup = "StealthGhost"
					end)
				end
			end
			hrp.Anchored = true
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			pcall(function()
				hum.EvaluateStateMachine = false
			end)
			rig.PrimaryPart = hrp
			rig:PivotTo(cf)
			rig.Parent = fxFolder
			pcall(dressRig, rig, isTarget)

			local tracks = {}
			pcall(function()
				local animator = hum:FindFirstChildOfClass("Animator") or make("Animator", {}, hum)
				for name, id in pairs(ANIMATIONS) do
					local animation = Instance.new("Animation")
					animation.AnimationId = id
					local track = animator:LoadAnimation(animation)
					track.Looped = true
					track.Priority = (name == "idle") and Enum.AnimationPriority.Idle or Enum.AnimationPriority.Movement
					tracks[name] = track
				end
			end)
			return rig, tracks, (hum.HipHeight + hrp.Size.Y / 2) - 3
		end
		rig:Destroy()
	end

	-- Fallback if the character rigs could not be made: a simple block figure.
	local rig = Instance.new("Model")
	local suit = isTarget and Color3.fromRGB(150, 25, 35) or Color3.fromRGB(34, 40, 62)
	local function piece(size, offset, color, material)
		return make("Part", {
			Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Size = size,
			CFrame = cf * CFrame.new(offset), Color = color, Material = material or Enum.Material.SmoothPlastic,
		}, rig)
	end
	rig.PrimaryPart = piece(Vector3.new(2, 2, 1), Vector3.new(0, 0, 0), suit)
	piece(Vector3.new(1.8, 2, 0.9), Vector3.new(0, -2, 0), Color3.fromRGB(20, 20, 26))
	piece(Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 1.6, 0), Color3.fromRGB(226, 188, 160))
	piece(Vector3.new(1, 0.25, 0.2), Vector3.new(0, 1.7, -0.6), Color3.fromRGB(90, 220, 255), Enum.Material.Neon)
	rig.Parent = fxFolder
	return rig, {}, 0
end

local function createVisual(guardModel, root)
	local isTarget = root:GetAttribute("IsTarget") == true
	local rig, tracks, yOffset = buildRig(isTarget, root.CFrame)

	local tris = {}
	for i = 1, CONE_SEGMENTS do
		local pair = {}
		for k = 1, 2 do
			pair[k] = make("WedgePart", {
				Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
				Material = Enum.Material.Neon, Transparency = 1, Size = Vector3.new(CONE_THICKNESS, 1, 1),
				TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth,
			}, fxFolder)
		end
		tris[i] = pair
	end

	local billboard = make("BillboardGui", {
		Adornee = root, Size = UDim2.new(0, 260, 0, 76), StudsOffset = Vector3.new(0, 5.5, 0), AlwaysOnTop = true,
		ResetOnSpawn = false,
	}, player.PlayerGui)
	local mark = label({ Size = UDim2.new(1, 0, 0, 40), TextSize = 34, TextStrokeTransparency = 0 }, billboard)
	local bark = label({
		Position = UDim2.new(0, 0, 0, 42), Size = UDim2.new(1, 0, 0, 24), Font = FONT_LIGHT, TextSize = 16,
		TextStrokeTransparency = 0.2,
	}, billboard)

	local v = {
		rig = rig, tracks = tracks, yOffset = yOffset, tris = tris, billboard = billboard, mark = mark, bark = bark,
		lastRootPos = root.Position, speed = 0, anim = nil, lastState = nil, barkUntil = 0,
	}
	visuals[guardModel] = v
	return v
end

local function destroyVisual(guardModel)
	local v = visuals[guardModel]
	if v then
		v.rig:Destroy()
		for _, pair in ipairs(v.tris) do
			pair[1]:Destroy()
			pair[2]:Destroy()
		end
		v.billboard:Destroy()
		visuals[guardModel] = nil
	end
end

-- Lays two wedge parts flat so together they fill the triangle a-b-c.
local function drawTriangle(a, b, c, w1, w2)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local cross = ac:Cross(ab)
	if cross.Magnitude < 0.001 or bc.Magnitude < 0.001 then
		return false
	end
	local right = cross.Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	w1.Size = Vector3.new(CONE_THICKNESS, height, math.abs(ab:Dot(back)))
	w1.CFrame = CFrame.fromMatrix((a + b) / 2, right, up, back)
	w2.Size = Vector3.new(CONE_THICKNESS, height, math.abs(ac:Dot(back)))
	w2.CFrame = CFrame.fromMatrix((a + c) / 2, -right, up, -back)
	return true
end

local BARKS = {
	chase = "HEY! Stop right there!",
	investigate = "Huh? What was that?",
	lost = "Lost them...",
	nothing = "Must have been nothing.",
}

local function updateGuards(viewRange, dt)
	for guardModel in pairs(visuals) do
		if guardModel.Parent ~= guardsFolder then
			destroyVisual(guardModel)
		end
	end
	local now = os.clock()

	for _, guardModel in ipairs(guardsFolder:GetChildren()) do
		local root = guardModel:FindFirstChild("Root")
		if root then
			local v = visuals[guardModel] or createVisual(guardModel, root)
			local down = root:GetAttribute("Down") == true
			local state = root:GetAttribute("State")
			local meter = root:GetAttribute("Meter") or 0
			local isTarget = root:GetAttribute("IsTarget") == true

			-- slide the character after the server's position so it moves smoothly
			local goal = root.CFrame * CFrame.new(0, v.yOffset, 0)
			if down then
				goal = root.CFrame * CFrame.new(0, -2.5, 0) * CFrame.Angles(-math.pi / 2, 0, 0)
			end
			local current = v.rig:GetPivot()
			if (current.Position - goal.Position).Magnitude > 20 then
				v.rig:PivotTo(goal)
			else
				v.rig:PivotTo(current:Lerp(goal, math.min(1, dt * 14)))
			end

			-- pick idle / walk / run from how fast the guard is really moving
			local moved = (root.Position - v.lastRootPos).Magnitude
			v.lastRootPos = root.Position
			local speedNow = (dt > 0) and (moved / dt) or 0
			v.speed = v.speed + (speedNow - v.speed) * math.min(1, dt * 6)
			local want = nil
			if not down then
				want = (v.speed > 11 and "run") or (v.speed > 1 and "walk") or "idle"
			end
			if want ~= v.anim then
				if v.anim and v.tracks[v.anim] then
					v.tracks[v.anim]:Stop(0.25)
				end
				if want and v.tracks[want] then
					v.tracks[want]:Play(0.25)
				end
				v.anim = want
			end
			if v.anim == "walk" and v.tracks.walk then
				v.tracks.walk:AdjustSpeed(math.clamp(v.speed / 9, 0.5, 1.4))
			end

			-- what the guard says when their mood changes
			if state ~= v.lastState then
				local line = nil
				if state == "chase" and not isTarget then
					line = BARKS.chase
				elseif state == "investigate" then
					line = BARKS.investigate
				elseif state == "return" then
					line = (v.lastState == "chase") and BARKS.lost or BARKS.nothing
				end
				if v.lastState ~= nil and line then
					v.bark.Text = line
					v.barkUntil = now + 2.4
				end
				v.lastState = state
			end
			if now > v.barkUntil or down then
				v.bark.Text = ""
			end

			-- marker over the head
			if down then
				v.mark.Text = ""
			elseif state == "chase" then
				v.mark.Text = "!"
				v.mark.TextColor3 = Color3.fromRGB(255, 60, 60)
			elseif meter > 0.1 or state == "investigate" then
				v.mark.Text = "?"
				v.mark.TextColor3 = Color3.fromRGB(255, 220, 80)
			elseif isTarget then
				v.mark.Text = "TARGET"
				v.mark.TextColor3 = Color3.fromRGB(255, 90, 90)
			else
				v.mark.Text = ""
			end
			v.mark.TextSize = (v.mark.Text == "TARGET") and 16 or 34

			-- vision cone: a see-through shape on the floor that stops at walls and cover
			local color = Color3.fromRGB(210, 228, 255)
			local alpha = 0.84
			if state == "chase" then
				color = Color3.fromRGB(255, 50, 50)
				alpha = 0.62
			elseif meter > 0.1 then
				color = Color3.fromRGB(255, 200, 60):Lerp(Color3.fromRGB(255, 50, 50), meter)
				alpha = 0.7
			end
			local pivot = v.rig:GetPivot()
			local center = Vector3.new(pivot.Position.X, origin.Y + 0.12, pivot.Position.Z)
			local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
			local hidden = down or look.Magnitude < 0.1
			local eye = Vector3.new(center.X, origin.Y + 4.5, center.Z)
			local previous = nil
			for i = 0, CONE_SEGMENTS do
				local point = nil
				if not hidden then
					local angle = -HALF_ANGLE + i / CONE_SEGMENTS * HALF_ANGLE * 2
					local dir = (CFrame.Angles(0, angle, 0) * look).Unit
					local hit = workspace:Raycast(eye, dir * viewRange, rayParams)
					local length = math.max(0.3, (hit and hit.Distance or viewRange) - 0.05)
					point = center + dir * length
				end
				if i > 0 then
					local pair = v.tris[i]
					local drawn = (not hidden) and drawTriangle(center, previous, point, pair[1], pair[2])
					for k = 1, 2 do
						pair[k].Transparency = drawn and alpha or 1
						pair[k].Color = color
					end
				end
				previous = point
			end
		end
	end
end

---------------------------------------------------------------------------
-- Extra feedback: detection bar, red screen edges, footstep rings, target pointer
---------------------------------------------------------------------------
local detectBack = make("Frame", {
	AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 92), Size = UDim2.new(0, 240, 0, 8),
	BackgroundColor3 = Color3.fromRGB(14, 16, 24), BackgroundTransparency = 0.3, BorderSizePixel = 0, Visible = false,
}, gui)
make("UICorner", { CornerRadius = UDim.new(1, 0) }, detectBack)
local detectFill = make("Frame", {
	Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(255, 200, 60), BorderSizePixel = 0,
}, detectBack)
make("UICorner", { CornerRadius = UDim.new(1, 0) }, detectFill)

local edgeGradients = {}
for _, e in ipairs({
	{ UDim2.new(0, 0, 0, 0), UDim2.new(0.2, 0, 1, 0), 0 },
	{ UDim2.new(0.8, 0, 0, 0), UDim2.new(0.2, 0, 1, 0), 180 },
	{ UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0.22, 0), 90 },
	{ UDim2.new(0, 0, 0.78, 0), UDim2.new(1, 0, 0.22, 0), 270 },
}) do
	local frame = make("Frame", {
		Position = e[1], Size = e[2], BackgroundColor3 = Color3.fromRGB(255, 30, 40), BorderSizePixel = 0,
		Active = false,
	}, gui)
	local gradient = make("UIGradient", { Rotation = e[3], Transparency = NumberSequence.new(1, 1) }, frame)
	table.insert(edgeGradients, gradient)
end
local shownDanger = -1

local pointer = label({
	AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 150, 0, 22), TextSize = 15, Visible = false,
	TextStrokeTransparency = 0.2,
})

local nextStepRing = 0

local function pulse(position, radius, color, time, startAlpha)
	local p = make("Part", {
		Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false,
		Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Color = color, Transparency = startAlpha,
		Size = Vector3.new(0.1, 2, 2),
		CFrame = CFrame.new(position.X, origin.Y + 0.18, position.Z) * CFrame.Angles(0, 0, math.rad(90)),
	}, fxFolder)
	TweenService:Create(p, TweenInfo.new(time), {
		Size = Vector3.new(0.1, radius * 2, radius * 2), Transparency = 1,
	}):Play()
	Debris:AddItem(p, time + 0.1)
end

local function updateFeedback(active, root, isCrouched)
	-- how close the most suspicious guard is to spotting you
	local danger = 0
	local targetPos = nil
	for _, guardModel in ipairs(guardsFolder:GetChildren()) do
		local guardRoot = guardModel:FindFirstChild("Root")
		if guardRoot and not guardRoot:GetAttribute("Down") then
			local meter = guardRoot:GetAttribute("Meter") or 0
			if guardRoot:GetAttribute("State") == "chase" then
				meter = 1
			end
			danger = math.max(danger, meter)
			if guardRoot:GetAttribute("IsTarget") then
				targetPos = guardRoot.Position
			end
		end
	end
	if not active then
		danger = 0
	end
	detectBack.Visible = active and danger > 0.02
	detectFill.Size = UDim2.new(danger, 0, 1, 0)
	detectFill.BackgroundColor3 = Color3.fromRGB(255, 200, 60):Lerp(Color3.fromRGB(255, 50, 50), danger)
	local rounded = math.floor(danger * 25 + 0.5) / 25
	if rounded ~= shownDanger then
		shownDanger = rounded
		local edge = 1 - 0.6 * rounded * rounded
		for _, gradient in ipairs(edgeGradients) do
			gradient.Transparency = NumberSequence.new(edge, 1)
		end
	end

	-- rings under your feet when your footsteps can be heard
	if active and root and not isCrouched then
		local vel = root.AssemblyLinearVelocity
		if Vector3.new(vel.X, 0, vel.Z).Magnitude > 10 and os.clock() > nextStepRing then
			nextStepRing = os.clock() + 0.45
			pulse(root.Position, Config.NOISE_RADIUS, Color3.fromRGB(230, 235, 255), 0.5, 0.86)
		end
	end

	-- arrow text at the screen edge toward the target (or the exit once the target is down)
	local goalText = "TARGET"
	if level:GetAttribute("TargetDown") == true then
		goalText = "EXIT"
		targetPos = origin + Vector3.new(Config.Level.exit[1], 3, Config.Level.exit[2])
	end
	if not (active and root and targetPos) then
		pointer.Visible = false
		return
	end
	local size = camera.ViewportSize
	local vp, onScreen = camera:WorldToViewportPoint(targetPos)
	if onScreen and vp.X > 70 and vp.X < size.X - 70 and vp.Y > 100 and vp.Y < size.Y - 130 then
		pointer.Visible = false
		return
	end
	local dx, dy = vp.X - size.X / 2, vp.Y - size.Y / 2
	if vp.Z < 0 then
		dx, dy = -dx, -dy
	end
	local scale = math.min(1, (size.X / 2 - 100) / math.max(1, math.abs(dx)), (size.Y / 2 - 140) / math.max(1, math.abs(dy)))
	pointer.Position = UDim2.new(0, size.X / 2 + dx * scale, 0, size.Y / 2 + dy * scale)
	pointer.Text = goalText .. "  " .. math.floor((targetPos - root.Position).Magnitude) .. "m"
	pointer.TextColor3 = (goalText == "EXIT") and Color3.fromRGB(110, 255, 160) or Color3.fromRGB(255, 110, 110)
	pointer.Visible = true
end

-- Returns the text for the [E] prompt, or "" if there is nothing to do here.
local function findPrompt(rootPos)
	local flat = Vector3.new(rootPos.X, 0, rootPos.Z)
	for _, guardModel in ipairs(guardsFolder:GetChildren()) do
		local root = guardModel:FindFirstChild("Root")
		if root and not root:GetAttribute("Down") and root:GetAttribute("State") ~= "chase" then
			local v = flat - Vector3.new(root.Position.X, 0, root.Position.Z)
			local d = v.Magnitude
			if d < Config.TAKEDOWN_RANGE and (d < 0.5 or root.CFrame.LookVector:Dot(v.Unit) < 0.2) then
				return "[E] Take down " .. (root:GetAttribute("GuardName") or "guard")
			end
		end
	end
	local fuse = level:FindFirstChild("FuseBox")
	if fuse and (flat - Vector3.new(fuse.Position.X, 0, fuse.Position.Z)).Magnitude < 7 then
		return "[E] Cut the power"
	end
	return ""
end

---------------------------------------------------------------------------
-- Every frame
---------------------------------------------------------------------------
local lastState = nil

RunService.RenderStepped:Connect(function(dt)
	local state = level:GetAttribute("State")
	local root = myRoot()
	-- StealthMenu sets InMenu to true while the 3D main menu is open.
	local inMenu = player:GetAttribute("InMenu") == true
	gui.Enabled = not inMenu

	if state ~= lastState then
		lastState = state
		if state == "briefing" then
			crouching = false
			results.Visible = false
			selected = {}
			refreshToolButtons()
		end
	end
	briefing.Visible = state == "briefing"

	-- Camera: looks down on the building from above and behind.
	if root and not inMenu then
		camera.CameraType = Enum.CameraType.Scriptable
		camera.FieldOfView = camera.FieldOfView + (50 - camera.FieldOfView) * 0.06
		local focus = Vector3.new(root.Position.X, origin.Y + 2, root.Position.Z)
		local goal = CFrame.lookAt(focus + Vector3.new(0, 54, 26), focus)
		if (camera.CFrame.Position - goal.Position).Magnitude > 150 then
			camera.CFrame = goal
		else
			camera.CFrame = camera.CFrame:Lerp(goal, 0.15)
		end
	end

	local lit = level:GetAttribute("Lit") == true
	local isCrouched = level:GetAttribute("Crouching") == true
	local viewRange = (lit and Config.VIEW_RANGE_LIT or Config.VIEW_RANGE_DARK)
		* (isCrouched and Config.CROUCH_RANGE_MULT or 1)
	updateGuards(viewRange, dt)
	updateFeedback(state == "active", root, isCrouched)

	-- HUD text
	objectiveLabel.Text = level:GetAttribute("Objective") or ""
	local active = state == "active"
	timerLabel.Visible = active
	statusLabel.Visible = active
	controlsLabel.Visible = active
	promptLabel.Visible = active
	if active then
		local startTime = level:GetAttribute("StartTime") or workspace:GetServerTimeNow()
		timerLabel.Text = formatTime(workspace:GetServerTimeNow() - startTime)
		if lit then
			statusLabel.Text = "IN THE LIGHT"
			statusLabel.TextColor3 = Color3.fromRGB(255, 210, 90)
		else
			statusLabel.Text = "HIDDEN IN THE DARK"
			statusLabel.TextColor3 = Color3.fromRGB(110, 230, 150)
		end
		if isCrouched then
			statusLabel.Text = statusLabel.Text .. "  (crouching)"
		end
		promptLabel.Text = root and findPrompt(root.Position) or ""
	end

	for i, slot in ipairs(toolSlots) do
		local name = selected[i]
		local count = name and level:GetAttribute("Tool_" .. name)
		if active and name and count then
			slot.frame.Visible = true
			slot.name.Text = "[" .. TOOL_KEYS[i] .. "] " .. Config.Tools[name].name
			slot.count.Text = (count > 0) and (count .. " left") or "empty"
			slot.frame.BackgroundTransparency = (count > 0) and 0.12 or 0.6
		else
			slot.frame.Visible = false
		end
	end
end)

---------------------------------------------------------------------------
-- Effects
---------------------------------------------------------------------------
local hintToken = 0
local function showHint(text, seconds)
	hintToken = hintToken + 1
	local token = hintToken
	hintLabel.Text = text
	task.delay(seconds or 2.5, function()
		if hintToken == token then
			hintLabel.Text = ""
		end
	end)
end

local function ring(position, radius, color, time)
	local p = make("Part", {
		Anchored = true, CanCollide = false, CanQuery = false, CastShadow = false,
		Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Color = color, Transparency = 0.4,
		Size = Vector3.new(0.2, 2, 2),
		CFrame = CFrame.new(position.X, origin.Y + 0.2, position.Z) * CFrame.Angles(0, 0, math.rad(90)),
	}, fxFolder)
	TweenService:Create(p, TweenInfo.new(time), {
		Size = Vector3.new(0.2, radius * 2, radius * 2), Transparency = 1,
	}):Play()
	Debris:AddItem(p, time + 0.1)
end

local alertToken = 0
local fx = {}

function fx.Alert(text)
	alertToken = alertToken + 1
	local token = alertToken
	alertLabel.Text = text
	alertLabel.Visible = true
	flash.BackgroundTransparency = 0.55
	TweenService:Create(flash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
	playSound("rbxasset://sounds/electronicpingshort.wav", 0.8)
	task.delay(1.6, function()
		if alertToken == token then
			alertLabel.Visible = false
		end
	end)
end

function fx.Hint(text)
	showHint(text)
end

function fx.Takedown(position, wasTarget)
	ring(position, wasTarget and 14 or 7, Color3.fromRGB(255, 255, 255), 0.4)
	playSound("rbxasset://sounds/swordslash.wav", 0.6)
	if wasTarget then
		-- quick zoom punch for the big moment
		camera.FieldOfView = 38
		showHint("TARGET DOWN. Get to the exit.", 4)
	end
end

function fx.Noise(position, radius)
	ring(position, radius, Color3.fromRGB(255, 220, 80), 0.8)
	playSound("rbxasset://sounds/clickfast.wav", 0.8)
end

function fx.Smoke(position, radius, time)
	local p = make("Part", {
		Anchored = true, CanCollide = false, CanQuery = false, CastShadow = false,
		Shape = Enum.PartType.Ball, Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(150, 155, 165), Transparency = 1, Size = Vector3.new(2, 2, 2),
		Position = Vector3.new(position.X, origin.Y + 2, position.Z),
	}, fxFolder)
	TweenService:Create(p, TweenInfo.new(0.5), {
		Size = Vector3.new(radius * 2, radius * 2, radius * 2), Transparency = 0.35,
	}):Play()
	task.delay(time - 1, function()
		if p.Parent then
			TweenService:Create(p, TweenInfo.new(1), { Transparency = 1 }):Play()
		end
	end)
	Debris:AddItem(p, time + 0.2)
end

function fx.Dart(from, to)
	local length = (to - from).Magnitude
	local p = make("Part", {
		Anchored = true, CanCollide = false, CanQuery = false, CastShadow = false,
		Material = Enum.Material.Neon, Color = Color3.fromRGB(120, 255, 200),
		Size = Vector3.new(0.15, 0.15, length), CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -length / 2),
	}, fxFolder)
	TweenService:Create(p, TweenInfo.new(0.3), { Transparency = 1 }):Play()
	Debris:AddItem(p, 0.4)
end

function fx.PowerCut(seconds)
	showHint("Power is out for " .. seconds .. " seconds.", 4)
	playSound("rbxasset://sounds/switch.wav", 0.8)
end

FxRemote.OnClientEvent:Connect(function(name, ...)
	local handler = fx[name]
	if handler then
		handler(...)
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX8"><Properties><string name="Name">StealthMenu</string><ProtectedString name="Source"><![CDATA[-- StealthMenu (LocalScript, goes in StarterPlayer > StarterPlayerScripts)
-- The 3D main menu. The camera starts on a copy of your character standing at the
-- start of a dark hallway. Picking a menu option glides the camera down the hallway
-- to a board on the wall for that menu.
--
-- This script and StealthClient talk through one flag on the player called "InMenu".
-- While it is true, StealthClient hides the game HUD and leaves the camera alone.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
player:SetAttribute("InMenu", true)

local Config = require(ReplicatedStorage:WaitForChild("StealthConfig"))
local level = workspace:WaitForChild("Level_" .. player.UserId)
local base = level:GetAttribute("Origin") + Vector3.new(0, 300, 0) -- the menu hallway floats above the building

local FONT = Enum.Font.GothamBold
local FONT_LIGHT = Enum.Font.Gotham
local RED = Color3.fromRGB(215, 45, 55)
local HALL_LENGTH = 142
local CHARACTER_SPOT = Vector3.new(-2.5, 0, 0)

local function make(class, props, parent)
	local obj = Instance.new(class)
	for k, v in pairs(props) do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

local function S(x, y, z)
	return base + Vector3.new(x, y, z)
end

---------------------------------------------------------------------------
-- Building the hallway (only on this player's screen)
---------------------------------------------------------------------------
local scene = Instance.new("Model")
scene.Name = "MenuScene"

local function block(name, size, position, color, material, extra)
	local props = {
		Name = name, Anchored = true, Size = size, Position = position, Color = color,
		Material = material or Enum.Material.SmoothPlastic, CanCollide = false, CanQuery = false,
		TopSurface = Enum.SurfaceType.Smooth, BottomSurface = Enum.SurfaceType.Smooth,
	}
	for k, v in pairs(extra or {}) do
		props[k] = v
	end
	return make("Part", props, scene)
end

local midZ = -60
local wallColor = Color3.fromRGB(26, 28, 38)
block("Floor", Vector3.new(16, 1, HALL_LENGTH), S(0, -0.5, midZ), Color3.fromRGB(18, 18, 24),
	Enum.Material.SmoothPlastic, { Reflectance = 0.25 })
block("Ceiling", Vector3.new(18, 1, HALL_LENGTH), S(0, 12.5, midZ), Color3.fromRGB(14, 14, 18))
block("LeftWall", Vector3.new(1, 13, HALL_LENGTH), S(-8.5, 6, midZ), wallColor, Enum.Material.Concrete)
block("RightWall", Vector3.new(1, 13, HALL_LENGTH), S(8.5, 6, midZ), wallColor, Enum.Material.Concrete)
block("EndWall", Vector3.new(18, 13, 1), S(0, 6, midZ - HALL_LENGTH / 2 - 0.5), wallColor, Enum.Material.Concrete)
block("BackWall", Vector3.new(18, 13, 1), S(0, 6, midZ + HALL_LENGTH / 2 + 0.5), wallColor, Enum.Material.Concrete)

-- ribs on the walls and beams on the ceiling so the hallway isn't a plain box
for z = 4, -128, -12 do
	for _, x in ipairs({ -7.75, 7.75 }) do
		-- leave the wall clear where a menu board hangs (left wall at -30 and -90, right wall at -60)
		local boardNear = (x < 0 and (math.abs(z + 30) < 8 or math.abs(z + 90) < 8)) or (x > 0 and math.abs(z + 60) < 8)
		if not boardNear then
		block("WallRib", Vector3.new(0.5, 12, 1.2), S(x, 6, z), Color3.fromRGB(16, 17, 24), Enum.Material.Metal)
		block("RibLight", Vector3.new(0.1, 7, 0.12), S(x > 0 and x - 0.3 or x + 0.3, 5.5, z), RED, Enum.Material.Neon,
			{ CastShadow = false, Transparency = 0.35 })
		end
	end
	block("CeilingBeam", Vector3.new(16, 0.6, 1.2), S(0, 11.7, z), Color3.fromRGB(16, 17, 24), Enum.Material.Metal)
end
-- a strip of darker polished floor down the middle, like a runner
block("Runner", Vector3.new(6, 0.05, HALL_LENGTH - 4), S(0, 0.03, midZ), Color3.fromRGB(70, 18, 24),
	Enum.Material.Fabric, { CastShadow = false })

-- red light strips along the floor
for _, x in ipairs({ -7.8, 7.8 }) do
	block("FloorStrip", Vector3.new(0.2, 0.1, HALL_LENGTH), S(x, 0.06, midZ), RED, Enum.Material.Neon,
		{ CastShadow = false })
end
-- dim ceiling lights down the hall
for z = -12, -124, -24 do
	local bar = block("CeilingLight", Vector3.new(6, 0.2, 0.8), S(0, 11.9, z), Color3.fromRGB(170, 185, 225),
		Enum.Material.Neon, { CastShadow = false })
	make("PointLight", { Range = 18, Brightness = 0.5, Color = Color3.fromRGB(170, 185, 225) }, bar)
end
-- spotlight on the character, plus a red glow behind them
local spotHolder = block("CharacterSpot", Vector3.new(1, 0.2, 1), S(CHARACTER_SPOT.X, 11.8, 1.5),
	Color3.fromRGB(255, 240, 220), Enum.Material.Neon, { CastShadow = false })
make("SpotLight", {
	Face = Enum.NormalId.Bottom, Range = 22, Brightness = 5, Angle = 55,
	Color = Color3.fromRGB(255, 236, 214), Shadows = true,
}, spotHolder)
local rim = block("RimGlow", Vector3.new(0.2, 0.2, 0.2), S(CHARACTER_SPOT.X, 4.5, -5), RED,
	Enum.Material.Neon, { Transparency = 1 })
make("PointLight", { Range = 12, Brightness = 2.2, Color = RED }, rim)

---------------------------------------------------------------------------
-- Boards on the walls (one per menu)
---------------------------------------------------------------------------
local playerGui = player:WaitForChild("PlayerGui")

local function text(props, parent)
	local baseProps = {
		BackgroundTransparency = 1, Font = FONT, TextColor3 = Color3.new(1, 1, 1), TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true, Text = "",
	}
	for k, v in pairs(props) do
		baseProps[k] = v
	end
	return make("TextLabel", baseProps, parent)
end

-- side: "left", "right" or "end". Returns the frame to put content in, and the camera view for it.
local function makeBoard(title, side, z)
	local part, face, view
	if side == "left" then
		part = block("Board", Vector3.new(0.3, 7, 12), S(-7.85, 5.5, z), Color3.fromRGB(12, 13, 20))
		face = Enum.NormalId.Right
		view = CFrame.lookAt(S(3.5, 5.5, z), S(-7.85, 5.5, z))
		block("BoardTrim", Vector3.new(0.3, 0.15, 12), S(-7.8, 1.9, z), RED, Enum.Material.Neon, { CastShadow = false })
	elseif side == "right" then
		part = block("Board", Vector3.new(0.3, 7, 12), S(7.85, 5.5, z), Color3.fromRGB(12, 13, 20))
		face = Enum.NormalId.Left
		view = CFrame.lookAt(S(-3.5, 5.5, z), S(7.85, 5.5, z))
		block("BoardTrim", Vector3.new(0.3, 0.15, 12), S(7.8, 1.9, z), RED, Enum.Material.Neon, { CastShadow = false })
	else
		part = block("Board", Vector3.new(12, 7, 0.3), S(0, 5.5, z), Color3.fromRGB(12, 13, 20))
		face = Enum.NormalId.Back
		view = CFrame.lookAt(S(0, 5.5, z + 13.5), S(0, 5.5, z))
		block("BoardTrim", Vector3.new(12, 0.15, 0.3), S(0, 1.9, z + 0.05), RED, Enum.Material.Neon, { CastShadow = false })
	end
	-- metal frame around the board
	local long = (side == "end") and Vector3.new(12.6, 0.3, 0.5) or Vector3.new(0.5, 0.3, 12.6)
	block("BoardFrame", long, part.Position + Vector3.new(0, 3.65, 0), Color3.fromRGB(60, 62, 74), Enum.Material.Metal)
	block("BoardFrame", long, part.Position - Vector3.new(0, 3.65, 0), Color3.fromRGB(60, 62, 74), Enum.Material.Metal)
	local surface = make("SurfaceGui", {
		Name = "Menu_" .. title, Adornee = part, Face = face, LightInfluence = 0, ResetOnSpawn = false,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 50,
	}, playerGui)
	local frame = make("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1 }, surface)
	make("UIPadding", {
		PaddingLeft = UDim.new(0, 28), PaddingRight = UDim.new(0, 28),
		PaddingTop = UDim.new(0, 20), PaddingBottom = UDim.new(0, 20),
	}, frame)
	text({ Size = UDim2.new(1, 0, 0, 40), TextSize = 38, TextColor3 = RED, Text = title }, frame)
	return frame, view, surface
end

local views = {
	main = CFrame.lookAt(S(2.5, 4.4, 8.5), S(-1.5, 4, 0)),
}
local surfaces = {}

-- CONTRACTS
